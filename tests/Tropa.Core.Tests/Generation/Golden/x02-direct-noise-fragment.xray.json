{
  "log": {
    "loglevel": "warning"
  },
  "inbounds": [
    {
      "tag": "direct-in",
      "listen": "127.0.0.1",
      "port": 31210,
      "protocol": "socks",
      "settings": {
        "auth": "password",
        "accounts": [
          {
            "user": "xray-user",
            "pass": "xray-pass"
          }
        ],
        "udp": true
      }
    }
  ],
  "outbounds": [
    {
      "tag": "direct",
      "protocol": "freedom",
      "settings": {
        "domainStrategy": "UseIPv4",
        "fragment": {
          "packets": "tlshello",
          "length": "1-5",
          "interval": "1-3"
        },
        "noises": [
          {
            "type": "rand",
            "packet": "5-10",
            "delay": "10-16"
          }
        ]
      }
    },
    {
      "tag": "block",
      "protocol": "blackhole"
    }
  ],
  "routing": {
    "rules": [
      {
        "type": "field",
        "inboundTag": [
          "direct-in"
        ],
        "outboundTag": "direct"
      }
    ]
  },
  "dns": {
    "servers": [
      "https://1.1.1.1/dns-query"
    ],
    "queryStrategy": "UseIPv4"
  }
}
