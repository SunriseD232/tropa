          }
        ]
      }
    ],
    "rules": [
      {
        "action": "sniff",
        "sniffer": [
          "http",
          "tls"
        ]
      },
      {
        "protocol": "dns",
        "action": "hijack-dns"
      },
      {
        "ip_version": 6,
        "action": "reject"
      },
      {
        "network": "udp",
        "port": 443,
        "action": "reject"
      },
      {
        "ip_is_private": true,
        "outbound": "direct"
      },
      {
        "rule_set": [
          "ru-services"
        ],
        "action": "route",
        "outbound": "direct"
      },
      {
        "rule_set": [
          "geosite-ru-blocked"
        ],
        "action": "route",
        "outbound": "proxy"
      },
      {
        "rule_set": [
          "geoip-ru-blocked"
        ],
        "action": "route",
        "outbound": "proxy"
      }
    ],
    "final": "direct",
    "default_domain_resolver": "local",
    "auto_detect_interface": true
  },
  "experimental": {
    "clash_api": {
      "external_controller": "127.0.0.1:19090",
