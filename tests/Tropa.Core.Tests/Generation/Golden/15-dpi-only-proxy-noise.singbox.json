    {
      "type": "socks",
      "tag": "dpi-direct",
      "server": "127.0.0.1",
      "server_port": 31201,
      "version": "5",
      "username": "xray-user",
      "password": "xray-pass"
    },
    {
      "type": "socks",
      "tag": "direct-noise",
      "server": "127.0.0.1",
      "server_port": 31201,
      "version": "5",
      "username": "xray-user",
      "password": "xray-pass"
    }
  ],
