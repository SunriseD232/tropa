{
  "log": {
    "level": "warn",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "type": "https",
        "tag": "remote",
        "server": "1.1.1.1"
      },
      {
        "type": "udp",
        "tag": "local",
        "server": "77.88.8.8"
      }
    ],
    "rules": [
      {
        "rule_set": [
          "ru-services",
          "geosite-category-gov-ru",
          "geosite-category-bank-ru",
          "geosite-ru-available-only-inside",
          "geosite-category-ru"
        ],
        "server": "local"
      },
      {
        "domain_suffix": [
          "ru",
          "su",
          "xn--p1ai"
        ],
        "server": "local"
      },
      {
        "rule_set": [
          "geosite-ru-blocked",
          "geosite-youtube",
          "geosite-discord",
          "geosite-telegram",
          "geosite-facebook",
          "geosite-instagram",
          "geosite-x"
