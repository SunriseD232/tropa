<Project Sdk="Microsoft.NET.Sdk">
  <!-- Хранилище, DPAPI, сеть, системный прокси пользователя, запуск ядра. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Tropa.Core\Tropa.Core.csproj" />
    <ProjectReference Include="..\Tropa.Ipc\Tropa.Ipc.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Lock-файлы вшиты в сборку: хэши ядер и баз нельзя подменить, положив рядом другой файл. -->
    <EmbeddedResource Include="..\..\tools\cores.lock.json" LogicalName="Tropa.cores.lock.json" />
    <EmbeddedResource Include="..\..\tools\geo.lock.json" LogicalName="Tropa.geo.lock.json" />
    <!-- Адрес манифеста, публичный ключ подписи и номер выпуска, с которым собран установщик (ADR-023). -->
    <EmbeddedResource Include="..\..\tools\update.config.json" LogicalName="Tropa.update.config.json" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Tropa.Infrastructure.Tests" />
    <InternalsVisibleTo Include="Tropa.Integration.Tests" />
  </ItemGroup>
</Project>
