<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Tropa.App.ViewModels"
             xmlns:v="using:Tropa.App.Views"
             xmlns:infra="using:Tropa.Infrastructure"
             x:Class="Tropa.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <UserControl.Styles>
    <Style Selector="TextBlock.note">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource Muted}" />
    </Style>
    <Style Selector="TextBlock.note.warn">
      <Setter Property="Foreground" Value="{DynamicResource WarnFg}" />
    </Style>
    <Style Selector="Button.expert"><Setter Property="Opacity" Value="0.7" /></Style>
    <Style Selector="Button.nav.expert"><Setter Property="Margin" Value="0,10,0,0" /></Style>
  </UserControl.Styles>

  <UserControl.DataTemplates>
    <DataTemplate DataType="vm:ToggleRow">
      <DockPanel Margin="0,8">
        <ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding Value}" OnContent="" OffContent="" IsEnabled="{Binding IsAvailable}" AutomationProperties.Name="{Binding Title}" />
        <Button DockPanel.Dock="Right" Classes="info" Margin="0,0,8,0" Command="{Binding InfoCommand}" />
        <StackPanel VerticalAlignment="Center" Spacing="2">
          <TextBlock Text="{Binding Title}" FontSize="15" TextWrapping="Wrap" />
          <TextBlock Classes="note" Classes.warn="{Binding NoteIsWarning}" Text="{Binding Note}" IsVisible="{Binding Note, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>
      </DockPanel>
    </DataTemplate>
    <DataTemplate DataType="vm:ChoiceRow">
      <DockPanel Margin="0,8">
        <Button DockPanel.Dock="Right" Classes="info" Margin="8,0,0,0" Command="{Binding InfoCommand}" />
        <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding Options}" SelectedIndex="{Binding Index}" Width="230" VerticalAlignment="Center" IsEnabled="{Binding IsAvailable}" AutomationProperties.Name="{Binding Title}" />
        <StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
          <TextBlock Text="{Binding Title}" FontSize="15" TextWrapping="Wrap" />
          <TextBlock Classes="note" Classes.warn="{Binding NoteIsWarning}" Text="{Binding Note}" IsVisible="{Binding Note, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>
      </DockPanel>
    </DataTemplate>
    <DataTemplate DataType="vm:TextRow">
      <StackPanel Margin="0,8" Spacing="6">
        <DockPanel>
          <Button DockPanel.Dock="Right" Classes="info" Margin="8,0,0,0" Command="{Binding InfoCommand}" />
          <TextBox DockPanel.Dock="Right" Width="230" VerticalAlignment="Center" IsVisible="{Binding !Multiline}" IsEnabled="{Binding IsAvailable}"
                   Text="{Binding Value, UpdateSourceTrigger=LostFocus}" PlaceholderText="{Binding Placeholder}" AutomationProperties.Name="{Binding Title}" />
          <StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
            <TextBlock Text="{Binding Title}" FontSize="15" TextWrapping="Wrap" />
            <TextBlock Classes="note" Classes.warn="{Binding NoteIsWarning}" Text="{Binding Note}" IsVisible="{Binding Note, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </StackPanel>
        </DockPanel>
        <TextBox IsVisible="{Binding Multiline}" IsEnabled="{Binding IsAvailable}" AcceptsReturn="True" TextWrapping="NoWrap" Height="120"
                 FontFamily="{StaticResource Mono}" Text="{Binding Value, UpdateSourceTrigger=LostFocus}" PlaceholderText="{Binding Placeholder}" AutomationProperties.Name="{Binding Title}" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="vm:ActionRow">
      <DockPanel Margin="0,8">
        <Button DockPanel.Dock="Right" Classes="info" Margin="8,0,0,0" Command="{Binding InfoCommand}" VerticalAlignment="Top" />
        <StackPanel Spacing="8">
          <StackPanel Spacing="2">
            <TextBlock Text="{Binding Title}" FontSize="15" TextWrapping="Wrap" />
            <TextBlock Classes="note" Text="{Binding Note}" IsVisible="{Binding Note, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </StackPanel>
          <WrapPanel>
            <Button Content="{Binding FirstLabel}" Command="{Binding FirstCommand}" Margin="0,0,8,0" />
            <Button Content="{Binding SecondLabel}" Command="{Binding SecondCommand}" IsVisible="{Binding HasSecond}" />
          </WrapPanel>
        </StackPanel>
      </DockPanel>
    </DataTemplate>
    <DataTemplate DataType="vm:CoreVersionsRow">
      <DockPanel Margin="0,8">
        <Button DockPanel.Dock="Right" Classes="info" Margin="8,0,0,0" Command="{Binding InfoCommand}" VerticalAlignment="Top" />
        <StackPanel Spacing="10">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
              <ProgressBar IsIndeterminate="True" Width="60" MinWidth="0" IsVisible="{Binding Busy}" VerticalAlignment="Center" />
              <Button Content="Обновить список" Command="{Binding RefreshCommand}" />
            </StackPanel>
            <StackPanel Spacing="2" Margin="0,0,12,0">
              <TextBlock Text="{Binding Title}" FontSize="15" TextWrapping="Wrap" />
              <TextBlock Classes="note" Text="{Binding Note}" IsVisible="{Binding Note, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
          </DockPanel>
          <ItemsControl ItemsSource="{Binding Cores}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:CoreVersionItem">
                <Border Background="{DynamicResource Card2}" CornerRadius="10" Padding="12,10" Margin="0,0,0,8">
                  <StackPanel Spacing="8">
                    <TextBlock>
                      <Run Text="{Binding Name}" FontWeight="SemiBold" /><Run Text="   " /><Run Text="{Binding Current}" Foreground="{DynamicResource Label}" />
                    </TextBlock>
                    <WrapPanel IsVisible="{Binding HasOptions}">
                      <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}" MinWidth="300" Margin="0,0,8,6"
                                AutomationProperties.Name="{Binding Name, StringFormat='Версия {0}'}">
                        <ComboBox.ItemTemplate>
                          <DataTemplate DataType="infra:CoreVersionOption">
                            <TextBlock Text="{Binding Label}" />
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                      <Button Classes="primary" Content="{Binding InstallLabel}" Command="{Binding InstallCommand}" Margin="0,0,8,6" />
                    </WrapPanel>
                    <TextBlock Classes="note" IsVisible="{Binding !HasOptions}" Text="Других версий пока нет. Нажмите «Обновить список»." />
                    <TextBlock Classes="note warn" Text="{Binding Warning}" TextWrapping="Wrap" IsVisible="{Binding Warning, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <WrapPanel>
                      <Button Content="{Binding RollbackLabel}" Command="{Binding RollbackCommand}" IsVisible="{Binding CanRollback}" Margin="0,0,8,0" />
                      <Button Content="Как в выпуске" Command="{Binding ReleaseCommand}" IsVisible="{Binding IsPicked}" />
                    </WrapPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Classes="muted" Classes.err="{Binding StatusIsError}"
                     IsVisible="{Binding Status, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock.Styles>
              <Style Selector="TextBlock.err"><Setter Property="Foreground" Value="{DynamicResource BadFg}" /></Style>
            </TextBlock.Styles>
          </TextBlock>
        </StackPanel>
      </DockPanel>
    </DataTemplate>
    <DataTemplate DataType="vm:LabelRow">
      <DockPanel Margin="0,8">
        <Button DockPanel.Dock="Right" Classes="info" Margin="8,0,0,0" Command="{Binding InfoCommand}" />
        <TextBlock DockPanel.Dock="Right" Text="{Binding Text}" Classes="muted" VerticalAlignment="Center" MaxWidth="260" TextAlignment="Right" />
        <TextBlock Text="{Binding Title}" FontSize="15" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" />
      </DockPanel>
    </DataTemplate>
  </UserControl.DataTemplates>

  <!-- «Настройки» (ADR-072, B → C): при входе — плитки разделов и поиск; раздел — список разделов слева, пункты справа. -->
  <StackPanel Spacing="16">
    <Border Background="{DynamicResource InfoBg}" CornerRadius="12" Padding="12,8" IsVisible="{Binding NeedsApply}">
      <DockPanel>
        <Button DockPanel.Dock="Right" Classes="primary" Content="Применить" Command="{Binding ApplyCommand}" />
        <TextBlock Foreground="{DynamicResource InfoFg}" VerticalAlignment="Center" TextWrapping="Wrap"
                   Text="Настройки сохранены. Чтобы они заработали, подключение переподключится на секунду." />
      </DockPanel>
    </Border>

    <Border CornerRadius="12" Padding="12" Background="{DynamicResource OkBg}" Classes.err="{Binding MessageIsError}"
            IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}">
      <Border.Styles>
        <Style Selector="Border.err"><Setter Property="Background" Value="{DynamicResource WarnBg}" /></Style>
      </Border.Styles>
      <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
    </Border>

    <!-- ================= Плитки разделов ================= -->
    <StackPanel Spacing="16" IsVisible="{Binding IsOverview}">
      <DockPanel>
        <TextBox DockPanel.Dock="Right" Width="320" Text="{Binding SearchText}" PlaceholderText="Найти настройку…"
                 AutomationProperties.Name="Найти настройку" VerticalAlignment="Center">
          <TextBox.InnerLeftContent>
            <v:Icon Data="{StaticResource IconSearch}" Width="16" Height="16" Margin="10,0,0,0" Foreground="{DynamicResource Muted}" />
          </TextBox.InnerLeftContent>
        </TextBox>
        <TextBlock Classes="h1" Text="Настройки" VerticalAlignment="Center" />
      </DockPanel>

      <ItemsControl ItemsSource="{Binding Sections}" IsVisible="{Binding !IsSearching}" Margin="0,0,-12,-12">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:SettingsSection">
            <Button Classes="tile" Classes.expert="{Binding IsExpert}" Margin="0,0,12,12" MinHeight="88" AutomationProperties.Name="{Binding Title}"
                    Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).SelectCommand}" CommandParameter="{Binding}">
              <StackPanel Spacing="4">
                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" />
                <TextBlock Classes="hint" Text="{Binding Summary}" MaxLines="2" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Результаты поиска -->
      <Border Classes="card" Padding="20,10" IsVisible="{Binding IsSearching}">
        <StackPanel>
          <TextBlock Classes="muted" Text="Ничего не нашлось. Попробуйте другое слово." IsVisible="{Binding !SearchResults.Count}" Margin="0,8" />
          <ItemsControl ItemsSource="{Binding SearchResults}" />
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- ================= Раздел: список слева, пункты справа ================= -->
    <Grid ColumnDefinitions="220,24,*" IsVisible="{Binding IsSection}">
      <StackPanel Grid.Column="0" Spacing="2">
        <Button Classes="link" Command="{Binding ShowOverviewCommand}" Margin="8,4,0,12" HorizontalAlignment="Left">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <v:Icon Data="{StaticResource IconBack}" Width="14" Height="14" VerticalAlignment="Center" />
            <TextBlock Text="Все настройки" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <ItemsControl ItemsSource="{Binding Sections}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SettingsSection">
              <Button Classes="nav" Classes.on="{Binding IsCurrent}" Classes.expert="{Binding IsExpert}" Height="38" FontSize="14"
                      Content="{Binding Title}" Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).SelectCommand}" CommandParameter="{Binding}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <StackPanel Grid.Column="2" Spacing="14">
        <Border Classes="card" IsVisible="{Binding SiteImportOpen}">
          <StackPanel Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="Импорт списка сайтов" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
              <Button Classes="info" Command="{Binding ShowInfoCommand}" CommandParameter="siteImport" />
            </StackPanel>
            <TextBlock Classes="hint" Text="Домены по строке, файл hosts, правила v2rayN (JSON) или Clash. Всё станет одним пунктом встроенных маршрутов." />
            <TextBox Text="{Binding SiteImportText}" AcceptsReturn="True" TextWrapping="NoWrap" Height="180"
                     FontFamily="{StaticResource Mono}" FontSize="12" PlaceholderText="discord.com&#10;DOMAIN-SUFFIX,x.com,PROXY&#10;domain:youtube.com" />
            <TextBlock Classes="hint" Text="{Binding SiteImportPreview}" IsVisible="{Binding SiteImportPreview, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                <Button Content="Из файла…" Command="{Binding PickSiteFileCommand}" />
                <Button Content="Отмена" Command="{Binding CancelSiteImportCommand}" />
                <Button Classes="primary" Content="Добавить правило" Command="{Binding ConfirmSiteImportCommand}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Куда направить:" VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding SiteImportActions}" SelectedIndex="{Binding SiteImportAction}" MinWidth="180" />
              </StackPanel>
            </DockPanel>
          </StackPanel>
        </Border>

        <Border Classes="card" Padding="20,10">
          <StackPanel>
            <TextBlock Text="{Binding Current.Title}" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,4" />
            <TextBlock Classes="hint" Text="{Binding Current.Description}" Margin="0,0,0,6"
                       IsVisible="{Binding Current.Description, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <ItemsControl ItemsSource="{Binding Current.Rows}" />
          </StackPanel>
        </Border>
        <Border Classes="card" IsVisible="{Binding ConfigPreview, Converter={x:Static ObjectConverters.IsNotNull}}">
          <TextBox Text="{Binding ConfigPreview}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" Height="360"
                   FontFamily="{StaticResource Mono}" FontSize="11" />
        </Border>
      </StackPanel>
    </Grid>
  </StackPanel>
</UserControl>
