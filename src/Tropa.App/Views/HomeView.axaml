<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Tropa.App.ViewModels"
             x:Class="Tropa.App.Views.HomeView"
             x:DataType="vm:HomeViewModel">
  <StackPanel Spacing="20">
    <StackPanel Spacing="4">
      <TextBlock Classes="h1" Text="Главная" />
      <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding SubscriptionLine, Converter={x:Static ObjectConverters.IsNotNull}}">
        <TextBlock Classes="muted" Text="{Binding SubscriptionLine}" VerticalAlignment="Center" />
        <Button Classes="info" Command="{Binding ShowInfoCommand}" CommandParameter="subInfo" />
      </StackPanel>
    </StackPanel>

    <Border Background="{DynamicResource BadBg}" CornerRadius="12" Padding="14,12" IsVisible="{Binding Blocking}">
      <DockPanel>
        <Button DockPanel.Dock="Right" Classes="primary" Content="Снять блокировку" Command="{Binding ReleaseBlockingCommand}" Margin="12,0,0,0" />
        <StackPanel Spacing="2">
          <TextBlock Text="Интернет заблокирован аварийной блокировкой" FontWeight="SemiBold" Foreground="{DynamicResource BadFg}" />
          <TextBlock Classes="muted" TextWrapping="Wrap"
                     Text="Подключение оборвалось, и kill switch не пускает трафик мимо туннеля. Подключитесь снова или снимите блокировку." />
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid ColumnDefinitions="1.15*,20,*">
      <StackPanel Grid.Column="0" Spacing="20">
        <!-- Кнопка подключения -->
        <Border Classes="card" Padding="24,32">
          <StackPanel Spacing="18" HorizontalAlignment="Stretch">
            <Button HorizontalAlignment="Center" Width="172" Height="172" CornerRadius="86"
                    Command="{Binding ToggleCommand}" IsEnabled="{Binding !IsBusy}"
                    Background="{DynamicResource PowerOff}" Foreground="{DynamicResource Text}"
                    Classes.connected="{Binding IsConnected}"
                    ToolTip.Tip="Подключить или отключить (Ctrl+Alt+P — в следующей версии)">
              <Button.Styles>
                <Style Selector="Button.connected">
                  <Setter Property="Background" Value="{DynamicResource Accent}" />
                  <Setter Property="Foreground" Value="{DynamicResource AccentDark}" />
                </Style>
              </Button.Styles>
              <StackPanel Spacing="8" HorizontalAlignment="Center">
                <TextBlock Text="⏻" FontSize="40" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding StateText}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" />
              </StackPanel>
            </Button>
            <TextBlock Text="{Binding SessionTime}" Classes="mono" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" />
            <Border IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}" CornerRadius="12" Padding="12,10"
                    Background="{DynamicResource InfoBg}" Classes.err="{Binding IsError}">
              <Border.Styles>
                <Style Selector="Border.err"><Setter Property="Background" Value="{DynamicResource BadBg}" /></Style>
              </Border.Styles>
              <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
            </Border>
            <Border Background="{DynamicResource Card2}" CornerRadius="12" Padding="16,12">
              <DockPanel>
                <Border DockPanel.Dock="Left" Background="{DynamicResource Chip}" CornerRadius="4" Width="34" Height="22" Margin="0,0,12,0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding CountryCode}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel>
                  <TextBlock Text="{Binding ServerName}" FontSize="15" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding ServerDetails}" Classes="muted" />
                </StackPanel>
              </DockPanel>
            </Border>
            <ComboBox ItemsSource="{Binding Servers}" SelectedItem="{Binding SelectedServer}" HorizontalAlignment="Stretch"
                      IsVisible="{Binding !!Servers.Count}" PlaceholderText="Выбрать другой сервер"
                      ToolTip.Tip="Быстрое переключение: если Тропа подключена, она сразу переподключится на выбранный сервер" />
          </StackPanel>
        </Border>

        <!-- Режим и маршрут -->
        <Border Classes="card">
          <StackPanel Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Classes="lbl" Text="ЧТО ПУСКАТЬ ЧЕРЕЗ ТРОПУ" VerticalAlignment="Center" />
              <Button Classes="info" Command="{Binding ShowInfoCommand}" CommandParameter="mode" />
            </StackPanel>
            <UniformGrid Columns="2">
              <RadioButton GroupName="mode" IsChecked="{Binding ModeTun}" Command="{Binding SetModeCommand}" CommandParameter="tun" Margin="0,0,8,0">
                <StackPanel>
                  <TextBlock Text="Весь компьютер" />
                  <TextBlock Classes="muted" Text="TUN · игры, Discord, UDP" />
                </StackPanel>
              </RadioButton>
              <RadioButton GroupName="mode" IsChecked="{Binding !ModeTun}" Command="{Binding SetModeCommand}" CommandParameter="proxy">
                <StackPanel>
                  <TextBlock Text="Только браузеры" />
                  <TextBlock Classes="muted" Text="системный прокси" />
                </StackPanel>
              </RadioButton>
            </UniformGrid>
            <TextBlock Classes="muted" Text="{Binding ModeNote}" Foreground="{DynamicResource WarnFg}" IsVisible="{Binding !TunAvailable}" />

            <DockPanel Margin="0,8,0,0">
              <ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding KillSwitch}" IsEnabled="{Binding KillSwitchEnabled}" OnContent="" OffContent="" />
              <Button DockPanel.Dock="Right" Classes="info" Margin="0,0,8,0" Command="{Binding ShowInfoCommand}" CommandParameter="killSwitch" />
              <StackPanel>
                <TextBlock Text="Аварийная блокировка (kill switch)" FontSize="15" />
                <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding KillSwitchReason, TargetNullValue='Если туннель оборвётся, интернет не пойдёт напрямую'}" />
              </StackPanel>
            </DockPanel>

            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
              <TextBlock Classes="lbl" Text="МАРШРУТ" VerticalAlignment="Center" />
              <Button Classes="info" Command="{Binding ShowInfoCommand}" CommandParameter="route" />
            </StackPanel>
            <ComboBox SelectedIndex="{Binding RouteIndex}" HorizontalAlignment="Stretch">
              <ComboBoxItem Content="Всё, кроме российского (рекомендуется)" />
              <ComboBoxItem Content="Только заблокированное" />
              <ComboBoxItem Content="Всё через прокси" />
            </ComboBox>
            <TextBlock Classes="muted" Text="{Binding RouteDescription}" />
          </StackPanel>
        </Border>
      </StackPanel>

      <StackPanel Grid.Column="2" Spacing="20">
        <!-- Обход DPI: работает и без сервера -->
        <Border Classes="card">
          <StackPanel Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Classes="lbl" Text="ОБХОД DPI" VerticalAlignment="Center" />
              <Button Classes="info" Command="{Binding ShowInfoCommand}" CommandParameter="dpiBypass" />
            </StackPanel>
            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="64" CornerRadius="14"
                    Command="{Binding ToggleDpiCommand}" IsEnabled="{Binding !DpiBusy}"
                    Background="{DynamicResource PowerOff}" Foreground="{DynamicResource Text}"
                    Classes.on="{Binding DpiOn}"
                    ToolTip.Tip="Открывает сайты, которые провайдер режет по содержимому трафика (замедленный YouTube, Facebook), без сервера">
              <Button.Styles>
                <Style Selector="Button.on">
                  <Setter Property="Background" Value="{DynamicResource Accent}" />
                  <Setter Property="Foreground" Value="{DynamicResource AccentDark}" />
                </Style>
              </Button.Styles>
              <TextBlock Text="{Binding DpiButtonText}" FontSize="16" FontWeight="Bold" />
            </Button>
            <DockPanel>
              <Button DockPanel.Dock="Right" Classes="info" VerticalAlignment="Center" Margin="8,0,0,0"
                      Command="{Binding ShowInfoCommand}" CommandParameter="dpiTune" />
              <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                      Command="{Binding TuneDpiCommand}" IsEnabled="{Binding !DpiTuning}"
                      Content="Подобрать настройки обхода"
                      ToolTip.Tip="Перебирает варианты обхода на YouTube и Discord и сохраняет рабочий — у разных провайдеров помогают разные настройки" />
            </DockPanel>
            <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding DpiStateText}" />
          </StackPanel>
        </Border>
        <Border Classes="card">
          <StackPanel Spacing="12">
            <TextBlock Classes="lbl" Text="ТРАФИК" />
            <UniformGrid Columns="2">
              <StackPanel>
                <TextBlock Classes="muted" Text="Загрузка" />
                <TextBlock Classes="mono" FontSize="24" Text="{Binding Down}" />
              </StackPanel>
              <StackPanel>
                <TextBlock Classes="muted" Text="Отдача" />
                <TextBlock Classes="mono" FontSize="24" Text="{Binding Up}" />
              </StackPanel>
            </UniformGrid>
            <TextBlock Classes="muted" Text="{Binding Totals}" />
          </StackPanel>
        </Border>
        <Border Classes="card">
          <StackPanel Spacing="8">
            <TextBlock Classes="lbl" Text="КАК ЭТО РАБОТАЕТ СЕЙЧАС" />
            <TextBlock Classes="muted" Text="{Binding HowItWorks}" />
            <TextBlock Classes="muted" Text="Ключи серверов хранятся зашифрованными, ядра запускаются только после проверки их контрольной суммы." />
          </StackPanel>
        </Border>
        <Border Classes="card" DataContext="{Binding Updates}" x:DataType="vm:UpdatesViewModel">
          <StackPanel Spacing="8">
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="Проверить" Command="{Binding CheckCommand}" IsVisible="{Binding Enabled}" />
              <TextBlock Classes="lbl" Text="ВЕРСИИ И ОБНОВЛЕНИЯ" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock Classes="muted" Text="{Binding Versions}" TextWrapping="Wrap" />
            <DockPanel IsVisible="{Binding CoresOffer, Converter={x:Static ObjectConverters.IsNotNull}}">
              <Button DockPanel.Dock="Right" Classes="primary" Content="Обновить" Command="{Binding InstallCoresCommand}" Margin="8,0,0,0" />
              <TextBlock Text="{Binding CoresOffer}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
            <DockPanel IsVisible="{Binding AppOffer, Converter={x:Static ObjectConverters.IsNotNull}}">
              <Button DockPanel.Dock="Right" Classes="primary" Content="Установить" Command="{Binding InstallAppCommand}" Margin="8,0,0,0" />
              <TextBlock Text="{Binding AppOffer}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Classes="muted" Classes.err="{Binding StatusIsError}"
                       IsVisible="{Binding Status, Converter={x:Static ObjectConverters.IsNotNull}}">
              <TextBlock.Styles>
                <Style Selector="TextBlock.err"><Setter Property="Foreground" Value="{DynamicResource BadFg}" /></Style>
              </TextBlock.Styles>
            </TextBlock>
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
  </StackPanel>
</UserControl>
