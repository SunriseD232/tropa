<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Tropa.App.ViewModels"
             xmlns:v="using:Tropa.App.Views"
             x:Class="Tropa.App.Views.HomeView"
             x:DataType="vm:HomeViewModel">
  <!-- Главная (ADR-072, вариант A + чипы маршрутов): кнопка, сервер, маршрут, одна строка режима. -->
  <StackPanel Spacing="16" MaxWidth="560" HorizontalAlignment="Center" Margin="0,12,0,0">

    <Border Background="{DynamicResource BadBg}" CornerRadius="12" Padding="14,12" IsVisible="{Binding Blocking}">
      <DockPanel>
        <Button DockPanel.Dock="Right" Classes="primary" Content="Снять блокировку" Command="{Binding ReleaseBlockingCommand}" Margin="12,0,0,0" />
        <StackPanel Spacing="2">
          <TextBlock Text="Интернет заблокирован аварийной блокировкой" FontWeight="SemiBold" Foreground="{DynamicResource BadFg}" TextWrapping="Wrap" />
          <TextBlock Classes="muted" Text="Подключение оборвалось, и Тропа не пускает трафик мимо сервера. Подключитесь снова или снимите блокировку." />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Обновления: только когда они есть -->
    <StackPanel Spacing="8" DataContext="{Binding Updates}" x:DataType="vm:UpdatesViewModel">
      <Border Background="{DynamicResource InfoBg}" CornerRadius="12" Padding="14,10" IsVisible="{Binding AppOffer, Converter={x:Static ObjectConverters.IsNotNull}}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Classes="primary" Content="Установить" Command="{Binding InstallAppCommand}" Margin="12,0,0,0" />
          <TextBlock Text="{Binding AppOffer}" Foreground="{DynamicResource InfoFg}" TextWrapping="Wrap" VerticalAlignment="Center" />
        </DockPanel>
      </Border>
      <Border Background="{DynamicResource InfoBg}" CornerRadius="12" Padding="14,10" IsVisible="{Binding CoresOffer, Converter={x:Static ObjectConverters.IsNotNull}}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Classes="primary" Content="Обновить" Command="{Binding InstallCoresCommand}" Margin="12,0,0,0" />
          <TextBlock Text="{Binding CoresOffer}" Foreground="{DynamicResource InfoFg}" TextWrapping="Wrap" VerticalAlignment="Center" />
        </DockPanel>
      </Border>
      <!-- Ответ на «Проверить обновления» из настроек -->
      <TextBlock Classes="hint" Text="{Binding Status}" HorizontalAlignment="Center" TextAlignment="Center"
                 IsVisible="{Binding Status, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </StackPanel>

    <!-- Кнопка подключения -->
    <Panel HorizontalAlignment="Center" Margin="0,8,0,0">
      <Button Classes="power" HorizontalAlignment="Center" Width="180" Height="180" CornerRadius="90"
              Command="{Binding ToggleCommand}" IsEnabled="{Binding !IsBusy}"
              Classes.connected="{Binding IsConnected}" Classes.busy="{Binding IsBusy}" Classes.failed="{Binding IsError}"
              ToolTip.Tip="Подключить или отключить" AutomationProperties.Name="Подключить или отключить">
        <!-- Цвета — только стилями: значение, заданное прямо на кнопке, перебивает любой стиль. -->
        <Button.Styles>
          <Style Selector="Button.power">
            <Setter Property="Background" Value="{DynamicResource PowerOff}" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
          </Style>
          <Style Selector="Button.connected">
            <Setter Property="Background" Value="{DynamicResource PowerOn}" />
            <Setter Property="Foreground" Value="{DynamicResource PowerOnFg}" />
          </Style>
          <Style Selector="Button.busy">
            <Setter Property="Background" Value="{DynamicResource PowerBusy}" />
            <Setter Property="Foreground" Value="{DynamicResource PowerBusyFg}" />
          </Style>
          <Style Selector="Button.busy:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PowerBusy}" />
            <Setter Property="Foreground" Value="{DynamicResource PowerBusyFg}" />
          </Style>
          <Style Selector="Button.failed">
            <Setter Property="Background" Value="{DynamicResource PowerErr}" />
            <Setter Property="Foreground" Value="{DynamicResource PowerErrFg}" />
          </Style>
          <Style Selector="Button.connected:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PowerOn}" />
            <Setter Property="Foreground" Value="{DynamicResource PowerOnFg}" />
            <Setter Property="Opacity" Value="0.9" />
          </Style>
          <Style Selector="Button.failed:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PowerErr}" />
            <Setter Property="Foreground" Value="{DynamicResource PowerErrFg}" />
            <Setter Property="Opacity" Value="0.9" />
          </Style>
        </Button.Styles>
        <StackPanel Spacing="8" HorizontalAlignment="Center">
          <v:Icon Data="{StaticResource IconPower}" Width="44" Height="44" HorizontalAlignment="Center" />
          <TextBlock Text="{Binding StateText}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" />
        </StackPanel>
      </Button>
      <!-- Страна выхода: у сервера бывает своё переключение внутри туннеля, поэтому проверяем по факту. -->
      <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-64,0" CornerRadius="999" Padding="10,4"
              Background="{DynamicResource Card2}" IsVisible="{Binding ExitRegion, Converter={x:Static ObjectConverters.IsNotNull}}"
              ToolTip.Tip="{Binding ExitRegionTip}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <v:Icon Data="{StaticResource IconGlobe}" Width="14" Height="14" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding ExitRegion}" FontSize="12" VerticalAlignment="Center" />
        </StackPanel>
      </Border>
    </Panel>

    <!-- Время и трафик — только при подключении -->
    <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Center" IsVisible="{Binding IsConnected}" ToolTip.Tip="{Binding Totals}">
      <TextBlock Text="{Binding SessionTime}" Classes="mono" Foreground="{DynamicResource Muted}" />
      <StackPanel Orientation="Horizontal" Spacing="4">
        <v:Icon Data="{StaticResource IconArrowDown}" Width="13" Height="13" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
        <TextBlock Text="{Binding Down}" Classes="mono" Foreground="{DynamicResource Muted}" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="4">
        <v:Icon Data="{StaticResource IconArrowUp}" Width="13" Height="13" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
        <TextBlock Text="{Binding Up}" Classes="mono" Foreground="{DynamicResource Muted}" />
      </StackPanel>
    </StackPanel>

    <Border IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}" CornerRadius="12" Padding="12,10"
            Background="{DynamicResource InfoBg}" Classes.err="{Binding IsError}">
      <Border.Styles>
        <Style Selector="Border.err"><Setter Property="Background" Value="{DynamicResource BadBg}" /></Style>
      </Border.Styles>
      <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
    </Border>

    <!-- Сервер: текущий и быстрый выбор одним списком -->
    <Panel HorizontalAlignment="Center" MinWidth="340" MaxWidth="460">
      <ComboBox ItemsSource="{Binding Servers}" SelectedItem="{Binding SelectedServer}" HorizontalAlignment="Stretch"
                IsVisible="{Binding !!Servers.Count}" AutomationProperties.Name="Сервер" Padding="12,8"
                ToolTip.Tip="Если Тропа подключена, она сразу переподключится на выбранный сервер">
        <ComboBox.SelectionBoxItemTemplate>
          <DataTemplate x:DataType="vm:ServerChoice">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Border Background="{DynamicResource Chip}" CornerRadius="3" Width="26" Height="18" ClipToBounds="True" VerticalAlignment="Center"
                      DataContext="{Binding $parent[UserControl].DataContext}" x:DataType="vm:HomeViewModel">
                <Panel>
                  <Image Source="{Binding Flag}" Stretch="UniformToFill" IsVisible="{Binding HasFlag}" RenderOptions.BitmapInterpolationMode="HighQuality" />
                  <TextBlock Text="{Binding CountryCode}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasFlag}" />
                </Panel>
              </Border>
              <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </DataTemplate>
        </ComboBox.SelectionBoxItemTemplate>
      </ComboBox>
      <StackPanel IsVisible="{Binding !Servers.Count}" Spacing="2" HorizontalAlignment="Center">
        <TextBlock Text="{Binding ServerName}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
        <TextBlock Text="{Binding ServerDetails}" Classes="muted" TextAlignment="Center" />
      </StackPanel>
    </Panel>

    <!-- Маршрут: чипами, переключение сразу -->
    <ListBox Classes="chips" ItemsSource="{Binding RouteChips}" SelectedIndex="{Binding RouteIndex}" HorizontalAlignment="Center"
             AutomationProperties.Name="Маршрут" ToolTip.Tip="{Binding RouteDescription}">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate><WrapPanel HorizontalAlignment="Center" /></ItemsPanelTemplate>
      </ListBox.ItemsPanel>
    </ListBox>

    <!-- Режим: одна строка, изменить — во всплывающем окне -->
    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
      <TextBlock Classes="muted" Text="{Binding ModeLine}" VerticalAlignment="Center" TextWrapping="NoWrap" />
      <TextBlock Classes="muted" Text="·" VerticalAlignment="Center" />
      <Button Classes="link" Content="изменить" AutomationProperties.Name="Изменить режим">
        <Button.Flyout>
          <Flyout Placement="Bottom">
            <StackPanel Spacing="6" Width="320">
              <TextBlock Classes="lbl" Text="ДЛЯ КАКИХ ПРОГРАММ" Margin="0,0,0,4" />
              <RadioButton GroupName="homeMode" IsChecked="{Binding ModeIsTun, Mode=OneWay}" IsEnabled="{Binding TunAvailable}"
                           Command="{Binding ChooseModeCommand}" CommandParameter="tun">
                <StackPanel>
                  <TextBlock Text="Весь компьютер" FontWeight="SemiBold" />
                  <TextBlock Classes="muted" Text="Игры, Discord, звонки — все программы. Режим TUN." />
                </StackPanel>
              </RadioButton>
              <RadioButton GroupName="homeMode" IsChecked="{Binding ModeIsBrowsers, Mode=OneWay}"
                           Command="{Binding ChooseModeCommand}" CommandParameter="browsers">
                <StackPanel>
                  <TextBlock Text="Только браузеры" FontWeight="SemiBold" />
                  <TextBlock Classes="muted" Text="Через прокси Windows. Службу ставить не нужно." />
                </StackPanel>
              </RadioButton>
              <RadioButton GroupName="homeMode" IsChecked="{Binding ModeIsPorts, Mode=OneWay}"
                           Command="{Binding ChooseModeCommand}" CommandParameter="ports">
                <StackPanel>
                  <TextBlock Text="Вручную" FontWeight="SemiBold" />
                  <TextBlock Classes="muted" Text="Прокси Windows не трогаем: программы настраиваются на порт Тропы сами." />
                </StackPanel>
              </RadioButton>
              <TextBlock Classes="muted" Text="{Binding ModeNote}" Foreground="{DynamicResource WarnFg}" IsVisible="{Binding !TunAvailable}" />
            </StackPanel>
          </Flyout>
        </Button.Flyout>
      </Button>
    </StackPanel>

    <TextBlock Classes="muted" Text="{Binding SubscriptionLine}" HorizontalAlignment="Center" TextAlignment="Center"
               IsVisible="{Binding SubscriptionLine, Converter={x:Static ObjectConverters.IsNotNull}}" />
  </StackPanel>
</UserControl>
