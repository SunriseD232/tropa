<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Tropa.App.ViewModels"
             xmlns:svc="using:Tropa.App.Services"
             xmlns:v="using:Tropa.App.Views"
             x:Class="Tropa.App.Views.TropaLayoutView"
             x:DataType="vm:MainWindowViewModel">
  <!-- Вид «Тропа»: боковое меню и экраны -->
  <Grid ColumnDefinitions="72,*">
    <!-- Узкое меню значков (ADR-072): подпись — во всплывающей подсказке -->
    <Border Grid.Column="0" Background="{DynamicResource Side}" BorderBrush="{DynamicResource SideLine}" BorderThickness="0,0,1,0" Padding="0,16">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Spacing="6">
          <Image Source="/Assets/logo.png" Width="30" Height="30" Margin="0,0,0,14" HorizontalAlignment="Center" ToolTip.Tip="{Binding CoreVersions}" />
          <Button Classes="rail" Classes.on="{Binding IsHome}" Command="{Binding NavigateCommand}" CommandParameter="home" ToolTip.Tip="Главная" ToolTip.Placement="Right" AutomationProperties.Name="Главная">
            <v:Icon Data="{StaticResource IconHome}" Width="22" Height="22" />
          </Button>
          <Button Classes="rail" Classes.on="{Binding IsServers}" Command="{Binding NavigateCommand}" CommandParameter="servers" ToolTip.Tip="Серверы" ToolTip.Placement="Right" AutomationProperties.Name="Серверы">
            <v:Icon Data="{StaticResource IconServers}" Width="22" Height="22" />
          </Button>
          <Button Classes="rail" Classes.on="{Binding IsRules}" Command="{Binding NavigateCommand}" CommandParameter="rules" ToolTip.Tip="Маршруты" ToolTip.Placement="Right" AutomationProperties.Name="Маршруты">
            <v:Icon Data="{StaticResource IconRoute}" Width="22" Height="22" />
          </Button>
          <Button Classes="rail" Classes.on="{Binding IsGames}" Command="{Binding NavigateCommand}" CommandParameter="games" ToolTip.Tip="Игры" ToolTip.Placement="Right" AutomationProperties.Name="Игры">
            <v:Icon Data="{StaticResource IconGamepad}" Width="22" Height="22" />
          </Button>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom" Spacing="6">
          <Ellipse Width="8" Height="8" HorizontalAlignment="Center" Margin="0,0,0,8" ToolTip.Tip="{Binding FooterStatus}"
                   Fill="{DynamicResource Line}" Classes.on="{Binding FooterConnected}">
            <Ellipse.Styles>
              <Style Selector="Ellipse.on"><Setter Property="Fill" Value="{DynamicResource Accent}" /></Style>
            </Ellipse.Styles>
          </Ellipse>
          <Button Classes="rail" Classes.on="{Binding IsDiagnostics}" Command="{Binding NavigateCommand}" CommandParameter="diagnostics" ToolTip.Tip="Диагностика" ToolTip.Placement="Right" AutomationProperties.Name="Диагностика">
            <v:Icon Data="{StaticResource IconPulse}" Width="22" Height="22" />
          </Button>
          <Button Classes="rail" Classes.on="{Binding IsSettings}" Command="{Binding NavigateCommand}" CommandParameter="settings" ToolTip.Tip="Настройки" ToolTip.Placement="Right" AutomationProperties.Name="Настройки">
            <v:Icon Data="{StaticResource IconGear}" Width="22" Height="22" />
          </Button>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Содержимое -->
    <DockPanel Grid.Column="1">
      <Border DockPanel.Dock="Top" IsVisible="{Binding Warning, Converter={x:Static ObjectConverters.IsNotNull}}"
              Background="{DynamicResource WarnBg}" Padding="16,10" Margin="36,20,36,0" CornerRadius="12">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
            <Button Content="Перезапустить от имени администратора" Command="{Binding RestartElevatedCommand}" IsVisible="{x:Static svc:Elevation.CanElevate}" />
            <Button Content="Понятно" Command="{Binding DismissWarningCommand}" />
          </StackPanel>
          <TextBlock Text="{Binding Warning}" Foreground="{DynamicResource WarnFg}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
        </DockPanel>
      </Border>
      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <ContentControl Content="{Binding CurrentPage}" Margin="36,28" />
      </ScrollViewer>
    </DockPanel>
  </Grid>
</UserControl>
