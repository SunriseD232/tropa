<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Tropa.App.ViewModels"
             x:Class="Tropa.App.Views.EditServerView"
             x:DataType="vm:EditServerViewModel">
  <UserControl.Styles>
    <Style Selector="TextBlock.f"><Setter Property="FontSize" Value="14" /><Setter Property="FontWeight" Value="Medium" /><Setter Property="Margin" Value="0,0,0,4" /></Style>
    <Style Selector="StackPanel.field"><Setter Property="Margin" Value="0,0,0,12" /></Style>
    <Style Selector="RadioButton"><Setter Property="Margin" Value="0,0,14,0" /></Style>
  </UserControl.Styles>
  <Border Classes="card" Width="980" MaxHeight="760" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="0">
    <DockPanel>
      <DockPanel DockPanel.Dock="Top" Margin="24,20,24,8">
        <Button DockPanel.Dock="Right" Content="✕" Width="40" Command="{Binding CloseCommand}" ToolTip.Tip="Закрыть" />
        <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      </DockPanel>

      <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="24,14">
        <StackPanel Spacing="10">
          <Border Background="{StaticResource BadBg}" CornerRadius="10" Padding="10,8" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="{Binding Error}" Foreground="{StaticResource BadFg}" TextWrapping="Wrap" />
          </Border>
          <DockPanel>
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="6" Margin="0,0,10,0" VerticalAlignment="Center">
              <TextBlock Classes="lbl" Text="ССЫЛКА" VerticalAlignment="Center" />
              <Button Classes="info" Command="{Binding ShowInfoCommand}" CommandParameter="link" />
            </StackPanel>
            <TextBox Text="{Binding Link}" IsReadOnly="True" FontFamily="{StaticResource Mono}" Foreground="{StaticResource Muted}"
                     PasswordChar="•" RevealPassword="{Binding ShowCredential}" />
          </DockPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Отмена" Command="{Binding CloseCommand}" />
            <Button Classes="primary" Content="Сохранить" Command="{Binding SaveCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <Grid ColumnDefinitions="*,*" Margin="24,8,24,8">
          <!-- Основное -->
          <StackPanel Grid.Column="0" Margin="0,0,16,0">
            <TextBlock Classes="lbl" Text="ОСНОВНОЕ" Margin="0,0,0,10" />
            <Border Background="{StaticResource WarnBg}" CornerRadius="10" Padding="10,8" Margin="0,0,0,12"
                    IsVisible="{Binding SubscriptionNote, Converter={x:Static ObjectConverters.IsNotNull}}">
              <TextBlock Text="{Binding SubscriptionNote}" Foreground="{StaticResource WarnFg}" TextWrapping="Wrap" />
            </Border>
            <StackPanel Classes="field"><TextBlock Classes="f" Text="Название" /><TextBox Text="{Binding Name}" /></StackPanel>
            <StackPanel Classes="field">
              <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Classes="f" Text="Протокол" /><Button Classes="info" Command="{Binding ShowInfoCommand}" CommandParameter="protocol" /></StackPanel>
              <ItemsControl ItemsSource="{Binding Protocols}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:OptionItem">
                    <RadioButton GroupName="proto" Content="{Binding Title}" IsChecked="{Binding IsChecked}" IsEnabled="{Binding IsEnabled}" ToolTip.Tip="{Binding Reason}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <Grid ColumnDefinitions="*,110" Classes="field" Margin="0,0,0,12">
              <StackPanel Grid.Column="0" Margin="0,0,10,0"><TextBlock Classes="f" Text="Адрес" /><TextBox Text="{Binding Address}" FontFamily="{StaticResource Mono}" /></StackPanel>
              <StackPanel Grid.Column="1"><TextBlock Classes="f" Text="Порт" /><TextBox Text="{Binding Port}" FontFamily="{StaticResource Mono}" /></StackPanel>
            </Grid>
            <StackPanel Classes="field">
              <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Classes="f" Text="{Binding CredentialLabel}" /><Button Classes="info" Command="{Binding ShowInfoCommand}" CommandParameter="uuid" /></StackPanel>
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="Показать" Command="{Binding ToggleCredentialCommand}" Margin="8,0,0,0" />
                <TextBox Text="{Binding Credential}" PasswordChar="•" RevealPassword="{Binding ShowCredential}" FontFamily="{StaticResource Mono}" />
              </DockPanel>
            </StackPanel>
            <StackPanel Classes="field">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <CheckBox Content="XTLS Vision (flow)" IsChecked="{Binding Vision}" IsEnabled="{Binding VisionEnabled}" />
                <Button Classes="info" Command="{Binding ShowInfoCommand}" CommandParameter="flow" />
              </StackPanel>
              <TextBlock Classes="muted" Foreground="{StaticResource WarnFg}" Text="{Binding VisionReason}" IsVisible="{Binding VisionReason, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
            <StackPanel Classes="field">
              <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Classes="f" Text="Транспорт" /><Button Classes="info" Command="{Binding ShowInfoCommand}" CommandParameter="transport" /></StackPanel>
              <ItemsControl ItemsSource="{Binding Transports}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:OptionItem">
                    <RadioButton GroupName="transport" Content="{Binding Title}" IsChecked="{Binding IsChecked}" IsEnabled="{Binding IsEnabled}" ToolTip.Tip="{Binding Reason}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <Grid ColumnDefinitions="*,*" IsVisible="{Binding HasPath}" Margin="0,0,0,12">
              <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Classes="f" Text="Путь (path)" /><Button Classes="info" Command="{Binding ShowInfoCommand}" CommandParameter="path" /></StackPanel>
                <TextBox Text="{Binding Path}" FontFamily="{StaticResource Mono}" />
              </StackPanel>
              <StackPanel Grid.Column="1"><TextBlock Classes="f" Text="Host" /><TextBox Text="{Binding Host}" FontFamily="{StaticResource Mono}" /></StackPanel>
            </Grid>
            <StackPanel Classes="field" IsVisible="{Binding IsXhttp}">
              <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Classes="f" Text="Режим XHTTP" /><Button Classes="info" Command="{Binding ShowInfoCommand}" CommandParameter="xhttpMode" /></StackPanel>
              <ComboBox ItemsSource="{Binding XhttpModes}" SelectedItem="{Binding XhttpMode}" HorizontalAlignment="Stretch" />
            </StackPanel>
            <StackPanel Classes="field" IsVisible="{Binding IsGrpc}">
              <TextBlock Classes="f" Text="Имя сервиса (serviceName)" /><TextBox Text="{Binding ServiceName}" FontFamily="{StaticResource Mono}" />
            </StackPanel>
            <StackPanel Classes="field">
              <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Classes="f" Text="Подключаться через" /><Button Classes="info" Command="{Binding ShowInfoCommand}" CommandParameter="chain" /></StackPanel>
              <ComboBox ItemsSource="{Binding Chains}" SelectedItem="{Binding Chain}" HorizontalAlignment="Stretch" />
            </StackPanel>
          </StackPanel>

          <!-- Безопасность -->
          <StackPanel Grid.Column="1" Margin="16,0,0,0">
            <TextBlock Classes="lbl" Text="БЕЗОПАСНОСТЬ" Margin="0,0,0,10" />
            <StackPanel Classes="field">
              <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Classes="f" Text="Тип" /><Button Classes="info" Command="{Binding ShowInfoCommand}" CommandParameter="security" /></StackPanel>
              <ItemsControl ItemsSource="{Binding Securities}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:OptionItem">
                    <RadioButton GroupName="security" Content="{Binding Title}" IsChecked="{Binding IsChecked}" IsEnabled="{Binding IsEnabled}" ToolTip.Tip="{Binding Reason}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <Border Background="{StaticResource WarnBg}" CornerRadius="10" Padding="10,8" Margin="0,0,0,12" IsVisible="{Binding DisabledNotes, Converter={x:Static ObjectConverters.IsNotNull}}">
              <TextBlock Text="{Binding DisabledNotes}" Foreground="{StaticResource WarnFg}" TextWrapping="Wrap" />
            </Border>
            <StackPanel Classes="field" IsVisible="{Binding !IsNone}">
              <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Classes="f" Text="SNI" /><Button Classes="info" Command="{Binding ShowInfoCommand}" CommandParameter="sni" /></StackPanel>
              <TextBox Text="{Binding Sni}" FontFamily="{StaticResource Mono}" />
            </StackPanel>
            <StackPanel Classes="field" IsVisible="{Binding IsReality}">
              <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Classes="f" Text="Публичный ключ (pbk)" /><Button Classes="info" Command="{Binding ShowInfoCommand}" CommandParameter="pbk" /></StackPanel>
              <TextBox Text="{Binding PublicKey}" FontFamily="{StaticResource Mono}" />
            </StackPanel>
            <Grid ColumnDefinitions="*,*" IsVisible="{Binding IsReality}" Margin="0,0,0,12">
              <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Classes="f" Text="Short ID" /><Button Classes="info" Command="{Binding ShowInfoCommand}" CommandParameter="sid" /></StackPanel>
                <TextBox Text="{Binding ShortId}" FontFamily="{StaticResource Mono}" />
              </StackPanel>
              <StackPanel Grid.Column="1">
                <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Classes="f" Text="SpiderX" /><Button Classes="info" Command="{Binding ShowInfoCommand}" CommandParameter="spx" /></StackPanel>
                <TextBox Text="{Binding SpiderX}" FontFamily="{StaticResource Mono}" />
              </StackPanel>
            </Grid>
            <StackPanel Classes="field" IsVisible="{Binding IsTls}">
              <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Classes="f" Text="ALPN" /><Button Classes="info" Command="{Binding ShowInfoCommand}" CommandParameter="alpn" /></StackPanel>
              <TextBox Text="{Binding Alpn}" PlaceholderText="h2,http/1.1" FontFamily="{StaticResource Mono}" />
            </StackPanel>
            <StackPanel Classes="field" IsVisible="{Binding !IsNone}">
              <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Classes="f" Text="Отпечаток (uTLS)" /><Button Classes="info" Command="{Binding ShowInfoCommand}" CommandParameter="utls" /></StackPanel>
              <ComboBox ItemsSource="{Binding Fingerprints}" SelectedItem="{Binding Fingerprint}" HorizontalAlignment="Stretch" />
            </StackPanel>
            <StackPanel Classes="field" IsVisible="{Binding IsTls}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <CheckBox Content="Не проверять сертификат" IsChecked="{Binding AllowInsecure}" />
                <Button Classes="info" Command="{Binding ShowInfoCommand}" CommandParameter="allowInsecure" />
              </StackPanel>
              <TextBlock Classes="muted" Foreground="{StaticResource BadFg}" IsVisible="{Binding AllowInsecure}"
                         Text="Трафик сможет прочитать любой посредник. Такой сервер не попадёт в авто-выбор." />
            </StackPanel>
            <Border Background="{StaticResource WarnBg}" CornerRadius="10" Padding="10,8" Margin="0,0,0,12" IsVisible="{Binding IsNone}">
              <TextBlock Foreground="{StaticResource WarnFg}" TextWrapping="Wrap" Text="Транспорт не шифруется: VLESS в таком виде ничего не скрывает от провайдера, VMess легко распознаётся." />
            </Border>
            <Border Background="{StaticResource InfoBg}" CornerRadius="10" Padding="10,8">
              <DockPanel>
                <Button DockPanel.Dock="Right" Classes="info" Command="{Binding ShowInfoCommand}" CommandParameter="coreChoice" />
                <TextBlock Text="{Binding CoreNote}" Foreground="{StaticResource InfoFg}" VerticalAlignment="Center" />
              </DockPanel>
            </Border>
          </StackPanel>
        </Grid>
      </ScrollViewer>
    </DockPanel>
  </Border>
</UserControl>
