<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:Tropa.App.Views"
             xmlns:vm="using:Tropa.App.ViewModels"
             x:Class="Tropa.App.Views.DiagnosticsView"
             x:DataType="vm:DiagnosticsViewModel">
  <!-- «Диагностика» (ADR-072, вариант A): «Найти проблему» и понятный ответ; журнал и отчёт — в окне «Для поддержки». -->
  <UserControl.Styles>
    <Style Selector="Border.step">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="CornerRadius" Value="15" />
      <Setter Property="Background" Value="{DynamicResource Card2}" />
    </Style>
    <Style Selector="Border.step.ok"><Setter Property="Background" Value="{DynamicResource OkBg}" /></Style>
    <Style Selector="Border.step.warn"><Setter Property="Background" Value="{DynamicResource WarnBg}" /></Style>
    <Style Selector="Border.step.bad"><Setter Property="Background" Value="{DynamicResource BadBg}" /></Style>
    <Style Selector="Border.step.run"><Setter Property="Background" Value="{DynamicResource InfoBg}" /></Style>
    <Style Selector="Border.step.ok"><Setter Property="TextElement.Foreground" Value="{DynamicResource OkFg}" /></Style>
    <Style Selector="Border.step.warn"><Setter Property="TextElement.Foreground" Value="{DynamicResource WarnFg}" /></Style>
    <Style Selector="Border.step.bad"><Setter Property="TextElement.Foreground" Value="{DynamicResource BadFg}" /></Style>
    <Style Selector="Border.step.run"><Setter Property="TextElement.Foreground" Value="{DynamicResource InfoFg}" /></Style>
  </UserControl.Styles>

  <StackPanel Spacing="16">
    <DockPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button Content="Остановить" Command="{Binding CancelCommand}" IsVisible="{Binding IsRunning}" />
        <Button Classes="primary" Content="Найти проблему" Command="{Binding RunCommand}" Padding="18,0" />
      </StackPanel>
      <StackPanel Spacing="4">
        <TextBlock Classes="h1" Text="Диагностика" />
        <TextBlock Classes="muted" Text="{Binding Summary}" />
      </StackPanel>
    </DockPanel>

    <Border Classes="card" Padding="20,6">
      <ItemsControl ItemsSource="{Binding Steps}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:StepItemViewModel">
            <DockPanel Margin="0,10">
              <Border DockPanel.Dock="Left" Classes="step" Classes.ok="{Binding IsOk}" Classes.warn="{Binding IsWarn}"
                      Classes.bad="{Binding IsBad}" Classes.run="{Binding IsRunning}" Margin="0,0,14,0" VerticalAlignment="Top">
                <Panel>
                  <TextBlock Text="{Binding Glyph}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  <v:Icon Data="{StaticResource IconCheck}" Width="14" Height="14" Thickness="2.6" IsVisible="{Binding IsOk}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  <v:Icon Data="{StaticResource IconClose}" Width="12" Height="12" Thickness="2.6" IsVisible="{Binding IsBad}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Panel>
              </Border>
              <Button DockPanel.Dock="Right" Classes="info" VerticalAlignment="Top"
                      Command="{Binding $parent[ItemsControl].((vm:DiagnosticsViewModel)DataContext).ShowInfoCommand}" CommandParameter="{Binding Key}" />
              <StackPanel Spacing="3" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Classes="hint" Text="{Binding Details}" IsVisible="{Binding Details, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <Border Background="{DynamicResource InfoBg}" CornerRadius="8" Padding="10,6" Margin="0,4,0,0" HorizontalAlignment="Left"
                        IsVisible="{Binding Action, Converter={x:Static ObjectConverters.IsNotNull}}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Что сделать:" FontWeight="SemiBold" Foreground="{DynamicResource InfoFg}" VerticalAlignment="Top" />
                    <TextBlock Text="{Binding Action}" Foreground="{DynamicResource InfoFg}" TextWrapping="Wrap" MaxWidth="560" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </DockPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>

    <DockPanel>
      <Button DockPanel.Dock="Left" Command="{Binding OpenSupportCommand}" AutomationProperties.Name="Для поддержки">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <v:Icon Data="{StaticResource IconPulse}" Width="16" Height="16" VerticalAlignment="Center" />
          <TextBlock Text="Для поддержки…" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <TextBlock Classes="hint" Margin="12,0,0,0" VerticalAlignment="Center"
                 Text="Журнал, проверка домена и отчёт без ключей и адресов — в отдельном окне." />
    </DockPanel>
  </StackPanel>
</UserControl>
