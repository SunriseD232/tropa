<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Tropa.App.ViewModels"
             x:Class="Tropa.App.Views.ServersView"
             x:DataType="vm:ServersViewModel">
  <UserControl.Styles>
    <Style Selector="Border.status.ok"><Setter Property="Background" Value="{DynamicResource OkBg}" /></Style>
    <Style Selector="Border.status.warn"><Setter Property="Background" Value="{DynamicResource WarnBg}" /></Style>
    <Style Selector="Border.status.bad"><Setter Property="Background" Value="{DynamicResource BadBg}" /></Style>
    <Style Selector="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="ToggleButton.tab">
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Height" Value="36" />
      <Setter Property="Padding" Value="14,0" />
    </Style>
  </UserControl.Styles>

  <StackPanel Spacing="18">
    <DockPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <ProgressBar IsIndeterminate="True" Width="80" IsVisible="{Binding IsBusy}" />
        <Button Content="Обновить подписки" Command="{Binding UpdateSubscriptionsCommand}" IsEnabled="{Binding !IsBusy}" />
        <Button Content="Тест всех" Command="{Binding TestAllCommand}" IsEnabled="{Binding !IsBusy}" />
        <Button Content="Вручную" Command="{Binding AddManualCommand}" ToolTip.Tip="Добавить сервер, заполнив поля" />
        <Button Classes="primary" Content="Добавить" Command="{Binding AddCommand}" />
      </StackPanel>
      <StackPanel Spacing="4">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Classes="h1" Text="Серверы" />
          <Button Classes="info" Command="{Binding ShowInfoCommand}" CommandParameter="subscription" />
        </StackPanel>
        <TextBlock Classes="muted" Text="{Binding Summary}" />
      </StackPanel>
    </DockPanel>

    <ItemsControl ItemsSource="{Binding Tabs}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:GroupTab">
          <ToggleButton Classes="tab" Margin="0,0,8,8" Content="{Binding Title}" IsChecked="{Binding IsSelected, Mode=OneWay}"
                        Command="{Binding $parent[ItemsControl].((vm:ServersViewModel)DataContext).SelectTabCommand}" CommandParameter="{Binding}" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <Border Classes="card" IsVisible="{Binding IsEmpty}">
      <StackPanel Spacing="10" HorizontalAlignment="Center" Margin="0,20">
        <TextBlock Text="Здесь появятся серверы" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
        <TextBlock Classes="muted" TextAlignment="Center" MaxWidth="460"
                   Text="Скопируйте ссылку на подписку, которую вам выдали, и нажмите Ctrl+V в этом окне. Или нажмите «Добавить»." />
        <Button Classes="primary" HorizontalAlignment="Center" Content="Добавить подписку" Command="{Binding AddCommand}" />
      </StackPanel>
    </Border>

    <Grid ColumnDefinitions="*,20,280" IsVisible="{Binding !IsEmpty}">
      <Border Grid.Column="0" Classes="card" Padding="8">
        <StackPanel>
          <Grid ColumnDefinitions="2*,84,104,1.1*,1.5*" Margin="12,6,12,10">
            <TextBlock Grid.Column="0" Classes="lbl" Text="СЕРВЕР" />
            <TextBlock Grid.Column="1" Classes="lbl" Text="ПРОТОКОЛ" Margin="8,0,0,0" />
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4">
              <TextBlock Classes="lbl" Text="СКОРОСТЬ" VerticalAlignment="Center" />
              <Button Classes="info" Width="20" Height="20" MinHeight="20" FontSize="11" Command="{Binding ShowInfoCommand}" CommandParameter="speedTest" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
              <TextBlock Classes="lbl" Text="ЗАДЕРЖКА" VerticalAlignment="Center" />
              <Button Classes="info" Width="20" Height="20" MinHeight="20" FontSize="11" Command="{Binding ShowInfoCommand}" CommandParameter="realDelay" />
            </StackPanel>
            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4">
              <TextBlock Classes="lbl" Text="СТАТУС" VerticalAlignment="Center" />
              <Button Classes="info" Width="20" Height="20" MinHeight="20" FontSize="11" Command="{Binding ShowInfoCommand}" CommandParameter="status" />
            </StackPanel>
          </Grid>
          <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" Background="Transparent" DoubleTapped="OnDoubleTapped">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ServerItemViewModel">
                <Grid ColumnDefinitions="2*,84,104,1.1*,1.5*" Height="40">
                  <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Background="{DynamicResource Chip}" CornerRadius="4" Width="30" Height="20">
                      <TextBlock Text="{Binding Country}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding Protocol}" VerticalAlignment="Center" Margin="8,0,0,0" />
                  <TextBlock Grid.Column="3" Text="{Binding Speed}" VerticalAlignment="Center" Classes="mono" />
                  <Panel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Delay}" Classes="mono" IsVisible="{Binding !Testing}" />
                    <ProgressBar IsIndeterminate="True" Width="56" MinWidth="0" IsVisible="{Binding Testing}" HorizontalAlignment="Left" />
                  </Panel>
                  <Border Grid.Column="4" Classes="pill status" Classes.ok="{Binding StatusKind, Converter={x:Static vm:StatusConverters.IsOk}}"
                          Classes.warn="{Binding StatusKind, Converter={x:Static vm:StatusConverters.IsWarn}}"
                          Classes.bad="{Binding StatusKind, Converter={x:Static vm:StatusConverters.IsBad}}"
                          HorizontalAlignment="Left" VerticalAlignment="Center" IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock Text="{Binding Status}" FontSize="12" TextTrimming="CharacterEllipsis" />
                  </Border>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </Border>

      <Border Grid.Column="2" Classes="card" VerticalAlignment="Top">
        <StackPanel Spacing="12" IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}">
          <TextBlock Text="{Binding Selected.Name}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Classes="muted" Text="{Binding Selected.Transport}" />
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
            <Grid.Styles>
              <Style Selector="TextBlock"><Setter Property="Margin" Value="0,3" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
            </Grid.Styles>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4" Margin="0,0,12,0">
              <TextBlock Classes="muted" Text="TCP-пинг" VerticalAlignment="Center" />
              <Button Classes="info" Width="20" Height="20" MinHeight="20" FontSize="11" Command="{Binding ShowInfoCommand}" CommandParameter="tcping" />
            </StackPanel>
            <TextBlock Grid.Row="0" Grid.Column="1" Classes="mono" Text="{Binding Selected.Tcp}" />
            <TextBlock Grid.Row="1" Classes="muted" Text="Задержка" />
            <TextBlock Grid.Row="1" Grid.Column="1" Classes="mono" Text="{Binding Selected.Delay}" />
            <TextBlock Grid.Row="2" Classes="muted" Text="Скорость" />
            <TextBlock Grid.Row="2" Grid.Column="1" Classes="mono" Text="{Binding Selected.Speed}" />
            <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="4" Margin="0,0,12,0">
              <TextBlock Classes="muted" Text="UDP" VerticalAlignment="Center" />
              <Button Classes="info" Width="20" Height="20" MinHeight="20" FontSize="11" Command="{Binding ShowInfoCommand}" CommandParameter="udpTest" />
            </StackPanel>
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Selected.Udp}" />
            <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="4" Margin="0,0,12,0">
              <TextBlock Classes="muted" Text="Стабильность" VerticalAlignment="Center" />
              <Button Classes="info" Width="20" Height="20" MinHeight="20" FontSize="11" Command="{Binding ShowInfoCommand}" CommandParameter="stability" />
            </StackPanel>
            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Selected.Stability}" />
          </Grid>
          <Border CornerRadius="10" Padding="10,8" Background="{DynamicResource Card2}">
            <TextBlock Text="{Binding Selected.Explanation}" TextWrapping="Wrap" />
          </Border>
          <TextBlock Classes="muted" Text="{Binding Selected.Checked}" />
          <UniformGrid Columns="2">
            <Button Content="Проверить" Command="{Binding TestSelectedCommand}" IsEnabled="{Binding NotBusy}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,4,0" />
            <Button Content="Стабильность" Command="{Binding StabilitySelectedCommand}" IsEnabled="{Binding NotBusy}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="4,0,0,0" />
          </UniformGrid>
          <Button Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="Использовать этот сервер" Command="{Binding UseSelectedCommand}" />
          <UniformGrid Columns="2">
            <Button Content="Изменить" Command="{Binding EditSelectedCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,4,0" />
            <Button Content="Удалить" Command="{Binding RemoveSelectedCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="4,0,0,0" />
          </UniformGrid>
          <TextBlock Classes="muted" Text="Ключ доступа хранится зашифрованным и здесь не показывается." />
        </StackPanel>
      </Border>
    </Grid>

    <Border Background="{DynamicResource InfoBg}" CornerRadius="12" Padding="12" IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}">
      <TextBlock Text="{Binding Message}" Foreground="{DynamicResource InfoFg}" TextWrapping="Wrap" />
    </Border>
  </StackPanel>
</UserControl>
