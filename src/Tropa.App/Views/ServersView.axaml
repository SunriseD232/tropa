<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sec="using:Tropa.Core.Security"
             xmlns:vm="using:Tropa.App.ViewModels"
             xmlns:v="using:Tropa.App.Views"
             x:Class="Tropa.App.Views.ServersView"
             x:DataType="vm:ServersViewModel">
  <UserControl.Styles>
    <Style Selector="Border.status.ok"><Setter Property="Background" Value="{DynamicResource OkBg}" /></Style>
    <Style Selector="Border.status.warn"><Setter Property="Background" Value="{DynamicResource WarnBg}" /></Style>
    <Style Selector="Border.status.bad"><Setter Property="Background" Value="{DynamicResource BadBg}" /></Style>
    <Style Selector="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="8,2" />
    </Style>
    <!-- «⋯» у строки — только при наведении и у выделенной -->
    <Style Selector="ListBoxItem Button.rowmore"><Setter Property="Opacity" Value="0" /></Style>
    <Style Selector="ListBoxItem:pointerover Button.rowmore"><Setter Property="Opacity" Value="1" /></Style>
    <Style Selector="ListBoxItem:selected Button.rowmore"><Setter Property="Opacity" Value="1" /></Style>
    <Style Selector="ToggleButton.tab">
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Height" Value="36" />
      <Setter Property="Padding" Value="14,0" />
    </Style>
    <Style Selector="Button.small">
      <Setter Property="Margin" Value="0,0,8,8" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Height" Value="34" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.sq">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <StackPanel Spacing="14">
    <!-- Шапка (ADR-072): подписка одним списком, «Проверить», «Добавить», остальное — в «⋯» -->
    <DockPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="12,0,0,0">
        <ProgressBar IsIndeterminate="True" Width="60" MinWidth="0" IsVisible="{Binding IsBusy}" VerticalAlignment="Center" />
        <ComboBox ItemsSource="{Binding Tabs}" SelectedItem="{Binding TabPick}" MinWidth="180" MaxWidth="260"
                  IsVisible="{Binding !IsEmpty}" AutomationProperties.Name="Подписка" ToolTip.Tip="Какие серверы показывать">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:GroupTab"><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" /></DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Button Content="Проверить" Command="{Binding CheckAllCommand}" IsEnabled="{Binding !IsBusy}" IsVisible="{Binding !IsEmpty}"
                ToolTip.Tip="Обновить подписки и проверить все серверы: задержку, скорость и UDP. Подключение не прерывается" />
        <Button Classes="primary" Command="{Binding AddCommand}" AutomationProperties.Name="Добавить серверы" ToolTip.Tip="Подписка, ссылка или QR-код. Скопированную ссылку можно просто вставить: Ctrl+V">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <v:Icon Data="{StaticResource IconPlus}" Width="14" Height="14" VerticalAlignment="Center" />
            <TextBlock Text="Добавить" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Classes="icon" ToolTip.Tip="Ещё" AutomationProperties.Name="Ещё действия">
          <v:Icon Data="{StaticResource IconMore}" Width="20" Height="20" Thickness="3" />
          <Button.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedRight">
              <MenuItem Header="Добавить сервер вручную" Command="{Binding AddManualCommand}" />
              <Separator />
              <MenuItem Header="Обновить эту подписку" Command="{Binding UpdateCurrentSubscriptionCommand}" IsVisible="{Binding CurrentTabInfo.IsSubscription, FallbackValue=False}" />
              <MenuItem Header="Переименовать подписку…" Command="{Binding AskRenameSubscriptionCommand}" IsVisible="{Binding CurrentTabInfo.IsSubscription, FallbackValue=False}" />
              <MenuItem Header="Подписку выше в списке" Command="{Binding MoveSubscriptionLeftCommand}" IsVisible="{Binding CurrentTabInfo.IsSubscription, FallbackValue=False}" />
              <MenuItem Header="Подписку ниже в списке" Command="{Binding MoveSubscriptionRightCommand}" IsVisible="{Binding CurrentTabInfo.IsSubscription, FallbackValue=False}" />
              <MenuItem Header="Удалить подписку…" Command="{Binding AskRemoveSubscriptionCommand}" IsVisible="{Binding CurrentTabInfo.IsSubscription, FallbackValue=False}" />
              <MenuItem Header="{Binding CurrentTabInfo.RestoreLabel, FallbackValue=''}" Command="{Binding RestoreHiddenCommand}" IsVisible="{Binding CurrentTabInfo.HasHidden, FallbackValue=False}" />
              <Separator />
              <MenuItem Header="Удалить дубликаты" Command="{Binding RemoveDuplicatesCommand}" />
              <MenuItem Header="Удалить нерабочие (по последней проверке)" Command="{Binding RemoveDeadCommand}" />
              <Separator />
              <MenuItem Header="Справка: подписки" Command="{Binding ShowInfoCommand}" CommandParameter="subscription" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>
      </StackPanel>
      <StackPanel Spacing="2" VerticalAlignment="Center">
        <TextBlock Classes="h1" Text="Серверы" />
        <TextBlock Classes="muted" Text="{Binding Summary}" />
      </StackPanel>
    </DockPanel>

    <!-- Поиск и фильтры: поле на виду, остальное — по кнопке -->
    <DockPanel IsVisible="{Binding !IsEmpty}">
      <Button DockPanel.Dock="Right" Content="Сбросить" Command="{Binding ClearFiltersCommand}" IsVisible="{Binding HasFilters}" Margin="8,0,0,0" />
      <Button DockPanel.Dock="Right" Margin="8,0,0,0" ToolTip.Tip="Протокол, скорость, страна выхода">
        <TextBlock Text="Фильтры" />
        <Button.Flyout>
          <Flyout Placement="BottomEdgeAlignedRight">
            <StackPanel Spacing="8" Width="240">
              <ComboBox ItemsSource="{x:Static vm:ServersViewModel.ProtocolOptions}" SelectedIndex="{Binding FilterProtocolIndex}" HorizontalAlignment="Stretch"
                        AutomationProperties.Name="Фильтр по протоколу" />
              <ComboBox ItemsSource="{x:Static vm:ServersViewModel.SpeedOptions}" SelectedIndex="{Binding FilterSpeedIndex}" HorizontalAlignment="Stretch"
                        AutomationProperties.Name="Фильтр по скорости" ToolTip.Tip="По последней проверке сервера" />
              <ComboBox ItemsSource="{Binding CountryOptions}" SelectedItem="{Binding FilterCountry}" HorizontalAlignment="Stretch"
                        AutomationProperties.Name="Фильтр по стране выхода" ToolTip.Tip="Страна выхода по последней проверке" />
            </StackPanel>
          </Flyout>
        </Button.Flyout>
      </Button>
      <TextBox Text="{Binding Filter}" PlaceholderText="Поиск по названию или адресу" AutomationProperties.Name="Фильтр по названию" />
    </DockPanel>

    <!-- Подписка от администратора (ADR-048): доверять ли ему выбор сервера и правила -->
    <Border Background="{DynamicResource InfoBg}" CornerRadius="12" Padding="14,12" IsVisible="{Binding CurrentTabInfo.HasAdmin, FallbackValue=False}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0" VerticalAlignment="Center">
          <Button Content="{Binding CurrentTabInfo.TrustLabel, FallbackValue=''}" Command="{Binding ToggleTrustAdminCommand}" />
          <Button Classes="info" Command="{Binding ShowInfoCommand}" CommandParameter="adminSub" />
        </StackPanel>
        <TextBlock Text="{Binding CurrentTabInfo.AdminNote, FallbackValue=''}" Foreground="{DynamicResource InfoFg}" TextWrapping="Wrap" VerticalAlignment="Center" />
      </DockPanel>
    </Border>

    <Border Background="{DynamicResource Card2}" CornerRadius="12" Padding="14,12" IsVisible="{Binding PendingSubscriptionName, Converter={x:Static ObjectConverters.IsNotNull}}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0" VerticalAlignment="Center">
          <Button Content="Отмена" Command="{Binding CancelRenameSubscriptionCommand}" />
          <Button Classes="primary" Content="Сохранить" Command="{Binding ConfirmRenameSubscriptionCommand}" />
        </StackPanel>
        <TextBox Text="{Binding PendingSubscriptionName}" MaxLength="{x:Static sec:NameSanitizer.MaxLength}" PlaceholderText="Пусто — имя от провайдера"
                 AutomationProperties.Name="Новое имя подписки">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding ConfirmRenameSubscriptionCommand}" />
            <KeyBinding Gesture="Escape" Command="{Binding CancelRenameSubscriptionCommand}" />
          </TextBox.KeyBindings>
        </TextBox>
      </DockPanel>
    </Border>

    <Border Background="{DynamicResource BadBg}" CornerRadius="12" Padding="14,12" IsVisible="{Binding PendingSubscriptionDelete, Converter={x:Static ObjectConverters.IsNotNull}}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0" VerticalAlignment="Center">
          <Button Content="Отмена" Command="{Binding CancelRemoveSubscriptionCommand}" />
          <Button Classes="primary" Content="Удалить" Command="{Binding ConfirmRemoveSubscriptionCommand}" />
        </StackPanel>
        <TextBlock Text="{Binding PendingSubscriptionDelete}" Foreground="{DynamicResource BadFg}" TextWrapping="Wrap" VerticalAlignment="Center" />
      </DockPanel>
    </Border>

    <Border Background="{DynamicResource BadBg}" CornerRadius="12" Padding="14,12" IsVisible="{Binding PendingConfirm, Converter={x:Static ObjectConverters.IsNotNull}}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0" VerticalAlignment="Center">
          <Button Content="Отмена" Command="{Binding CancelPendingCommand}" />
          <Button Classes="primary" Content="{Binding PendingConfirmLabel}" Command="{Binding ConfirmPendingCommand}" />
        </StackPanel>
        <TextBlock Text="{Binding PendingConfirm}" Foreground="{DynamicResource BadFg}" TextWrapping="Wrap" VerticalAlignment="Center" />
      </DockPanel>
    </Border>

    <Border Background="{DynamicResource InfoBg}" CornerRadius="12" Padding="12" IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}">
      <TextBlock Text="{Binding Message}" Foreground="{DynamicResource InfoFg}" TextWrapping="Wrap" />
    </Border>

    <Border Classes="card" IsVisible="{Binding IsEmpty}">
      <StackPanel Spacing="10" HorizontalAlignment="Center" Margin="0,20">
        <TextBlock Text="Здесь появятся серверы" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
        <TextBlock Classes="muted" TextAlignment="Center" MaxWidth="460"
                   Text="Скопируйте ссылку на подписку, которую вам выдали, и нажмите Ctrl+V в этом окне. Или нажмите «Добавить»." />
        <Button Classes="primary" HorizontalAlignment="Center" Content="Добавить подписку" Command="{Binding AddCommand}" />
      </StackPanel>
    </Border>

    <!-- Список (ADR-072): флаг, название, задержка, «⋯». Подробности — под выделенной строкой. -->
    <Border Classes="card" Padding="6" IsVisible="{Binding !IsEmpty}">
      <StackPanel>
        <TextBlock Classes="muted" Margin="12,8" Text="Здесь пусто: серверов в этой подписке нет или их скрыли фильтры." IsVisible="{Binding !Items.Count}" />
        <ListBox x:Name="List" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" Background="Transparent" DoubleTapped="OnDoubleTapped"
                 SelectionMode="Multiple" SelectionChanged="OnSelectionChanged" KeyDown="OnListKeyDown">
          <ListBox.KeyBindings>
            <KeyBinding Gesture="Delete" Command="{Binding RemoveSelectedCommand}" />
            <KeyBinding Gesture="Alt+Up" Command="{Binding MoveUpCommand}" />
            <KeyBinding Gesture="Alt+Down" Command="{Binding MoveDownCommand}" />
            <KeyBinding Gesture="Enter" Command="{Binding UseSelectedCommand}" />
          </ListBox.KeyBindings>
          <ListBox.ContextMenu>
            <ContextMenu x:Name="RowMenu">
              <MenuItem Header="Использовать этот сервер" InputGesture="Enter" Command="{Binding UseSelectedCommand}" IsVisible="{Binding !PickedMany}" />
              <MenuItem Header="Проверить" Command="{Binding TestSelectedCommand}" />
              <MenuItem Header="Проверить стабильность" Command="{Binding StabilitySelectedCommand}" IsVisible="{Binding !PickedMany}" />
              <MenuItem Header="Изменить" Command="{Binding EditSelectedCommand}" IsVisible="{Binding !PickedMany}" />
              <MenuItem Header="Поделиться" IsVisible="{Binding !PickedMany}">
                <MenuItem Header="Скопировать ссылку" Command="{Binding CopyLinkCommand}" />
                <MenuItem Header="Показать QR-код" Command="{Binding ShowQrCommand}" />
                <MenuItem Header="Выгрузить полный конфиг (с ключами)…" Command="{Binding ExportConfigCommand}" />
              </MenuItem>
              <MenuItem Header="Создать копию" Command="{Binding CloneCommand}" />
              <Separator />
              <MenuItem Header="Выше" InputGesture="Alt+Up" Command="{Binding MoveUpCommand}" IsVisible="{Binding !PickedMany}" />
              <MenuItem Header="Ниже" InputGesture="Alt+Down" Command="{Binding MoveDownCommand}" IsVisible="{Binding !PickedMany}" />
              <Separator />
              <MenuItem Header="Удалить" InputGesture="Delete" Command="{Binding RemoveSelectedCommand}" />
            </ContextMenu>
          </ListBox.ContextMenu>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ServerItemViewModel">
              <StackPanel>
                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" MinHeight="42">
                  <Border Grid.Column="0" Background="{DynamicResource Chip}" CornerRadius="4" Width="28" Height="20" Margin="2,0,12,0" VerticalAlignment="Center"
                          ClipToBounds="True" ToolTip.Tip="{Binding CountryTip}">
                    <Panel>
                      <Image Source="{Binding Flag}" Stretch="UniformToFill" IsVisible="{Binding HasFlag}" RenderOptions.BitmapInterpolationMode="HighQuality" />
                      <TextBlock Text="{Binding Country}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasFlag}" />
                    </Panel>
                  </Border>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <Border Classes="pill" Background="{DynamicResource OkBg}" IsVisible="{Binding IsActive}" VerticalAlignment="Center">
                      <TextBlock Text="используется" FontSize="11" Foreground="{DynamicResource OkFg}" />
                    </Border>
                  </StackPanel>
                  <Border Grid.Column="2" Classes="pill status" Margin="8,0" Classes.warn="{Binding StatusKind, Converter={x:Static vm:StatusConverters.IsWarn}}"
                          Classes.bad="{Binding StatusKind, Converter={x:Static vm:StatusConverters.IsBad}}"
                          VerticalAlignment="Center" ToolTip.Tip="{Binding Status}">
                    <Border.IsVisible>
                      <MultiBinding Converter="{x:Static BoolConverters.Or}">
                        <Binding Path="StatusKind" Converter="{x:Static vm:StatusConverters.IsWarn}" />
                        <Binding Path="StatusKind" Converter="{x:Static vm:StatusConverters.IsBad}" />
                      </MultiBinding>
                    </Border.IsVisible>
                    <TextBlock Text="{Binding Status}" FontSize="12" MaxWidth="180" TextTrimming="CharacterEllipsis" />
                  </Border>
                  <Panel Grid.Column="3" VerticalAlignment="Center" MinWidth="64">
                    <TextBlock Text="{Binding Delay}" Classes="mono" HorizontalAlignment="Right" IsVisible="{Binding !Testing}" />
                    <ProgressBar IsIndeterminate="True" Width="48" MinWidth="0" IsVisible="{Binding Testing}" HorizontalAlignment="Right" />
                  </Panel>
                  <Button Grid.Column="4" Classes="icon rowmore" Margin="6,0,0,0" Click="OnRowMore" ToolTip.Tip="Действия" AutomationProperties.Name="Действия с сервером">
                    <v:Icon Data="{StaticResource IconMore}" Width="18" Height="18" Thickness="3" />
                  </Button>
                </Grid>
                <!-- Подробности проверки: только у одного выделенного сервера -->
                <StackPanel IsVisible="{Binding ShowDetails}" Spacing="6" Margin="42,2,8,10">
                  <TextBlock Classes="muted">
                    <Run Text="{Binding Protocol}" /><Run Text=" · " /><Run Text="{Binding Transport}" /><Run Text=" · " /><Run Text="{Binding CoreLabel}" />
                  </TextBlock>
                  <WrapPanel>
                    <WrapPanel.Styles>
                      <Style Selector="TextBlock"><Setter Property="Margin" Value="0,0,18,0" /></Style>
                    </WrapPanel.Styles>
                    <TextBlock Classes="muted"><Run Text="TCP-пинг " /><Run Text="{Binding Tcp}" Foreground="{DynamicResource Text}" /></TextBlock>
                    <TextBlock Classes="muted"><Run Text="Скорость " /><Run Text="{Binding Speed}" Foreground="{DynamicResource Text}" /></TextBlock>
                    <TextBlock Classes="muted"><Run Text="UDP " /><Run Text="{Binding Udp}" Foreground="{DynamicResource Text}" /></TextBlock>
                    <TextBlock Classes="muted"><Run Text="Стабильность " /><Run Text="{Binding Stability}" Foreground="{DynamicResource Text}" /></TextBlock>
                  </WrapPanel>
                  <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" IsVisible="{Binding Explanation, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  <TextBlock Classes="hint" Text="{Binding Checked}" />
                </StackPanel>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </StackPanel>
    </Border>

    <!-- Выделено несколько (Ctrl/Shift + щелчок): действия для всех выбранных -->
    <Border Background="{DynamicResource Card2}" CornerRadius="12" Padding="14,8" IsVisible="{Binding PickedMany}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
          <Button Content="Проверить" Command="{Binding TestSelectedCommand}" IsEnabled="{Binding NotBusy}" />
          <Button Content="Создать копии" Command="{Binding CloneCommand}" />
          <Button Command="{Binding RemoveSelectedCommand}" ToolTip.Tip="Удалить выбранные (Delete)">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <v:Icon Data="{StaticResource IconTrash}" Width="14" Height="14" VerticalAlignment="Center" Foreground="{DynamicResource BadFg}" />
              <TextBlock Text="Удалить" VerticalAlignment="Center" Foreground="{DynamicResource BadFg}" />
            </StackPanel>
          </Button>
          <Button Classes="icon" Click="OnClearPicked" ToolTip.Tip="Снять выделение (Esc)" AutomationProperties.Name="Снять выделение">
            <v:Icon Data="{StaticResource IconClose}" Width="16" Height="16" />
          </Button>
        </StackPanel>
        <TextBlock Text="{Binding PickedText}" FontWeight="SemiBold" VerticalAlignment="Center" />
      </DockPanel>
    </Border>

    <TextBlock Classes="hint" IsVisible="{Binding !IsEmpty}"
               Text="Двойной щелчок или Enter — подключиться. Ctrl+щелчок — добавить к выбору, Shift+щелчок — диапазон, Ctrl+A — все, Esc — снять выбор. Ключи хранятся зашифрованными." />
  </StackPanel>
</UserControl>
