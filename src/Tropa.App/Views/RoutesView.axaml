<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:Tropa.App.Views"
             xmlns:vm="using:Tropa.App.ViewModels"
             x:Class="Tropa.App.Views.RoutesView"
             x:DataType="vm:RoutesViewModel">
  <!--
    Экран «Маршруты» (ADR-067, вид — ADR-072 вариант B): карточки маршрутов, включение одним нажатием,
    редактор справа с вкладками «Сайты и программы» / «Ещё». Прежний экран «Правила» — RulesView.
  -->
  <UserControl.Styles>
    <Style Selector="Border.route">
      <Setter Property="Background" Value="{DynamicResource Card}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="16,14" />
      <Setter Property="Margin" Value="0,0,12,12" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Border.route:pointerover"><Setter Property="BorderBrush" Value="{DynamicResource FieldBorder}" /></Style>
    <Style Selector="Border.route.active">
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
      <Setter Property="Background" Value="{DynamicResource NavOnBg}" />
    </Style>
    <Style Selector="Border.route.editing"><Setter Property="BorderBrush" Value="{DynamicResource InfoFg}" /></Style>
    <Style Selector="Border.row">
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="0,1,0,0" />
      <Setter Property="Padding" Value="2,10" />
    </Style>
  </UserControl.Styles>

  <UserControl.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding Editor.CloseCommand, FallbackValue={x:Null}}" />
  </UserControl.KeyBindings>
  <Grid ColumnDefinitions="*,Auto">
    <!-- ================= Карточки маршрутов ================= -->
    <StackPanel Grid.Column="0" Spacing="14">
      <DockPanel>
        <Button DockPanel.Dock="Right" Command="{Binding CreateCommand}" VerticalAlignment="Center" AutomationProperties.Name="Новый маршрут">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <v:Icon Data="{StaticResource IconPlus}" Width="14" Height="14" VerticalAlignment="Center" />
            <TextBlock Text="Новый маршрут" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Classes="h1" Text="Маршруты" />
          <Button Classes="info" Command="{Binding ShowInfoCommand}" CommandParameter="routes" />
        </StackPanel>
      </DockPanel>

      <Border Background="{DynamicResource InfoBg}" CornerRadius="12" Padding="12,8" IsVisible="{Binding Shared.NeedsApply}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Classes="primary" Content="Применить" Command="{Binding Shared.ApplyCommand}" />
          <TextBlock Foreground="{DynamicResource InfoFg}" VerticalAlignment="Center" TextWrapping="Wrap"
                     Text="Маршрут изменён. Подключение переподключится на секунду." />
        </DockPanel>
      </Border>

      <Border Background="{DynamicResource WarnBg}" CornerRadius="12" Padding="12" IsVisible="{Binding PendingDelete, Converter={x:Static ObjectConverters.IsNotNull}}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
            <Button Content="Отмена" Command="{Binding CancelDeleteCommand}" />
            <Button Content="Удалить" Command="{Binding ConfirmDeleteCommand}" />
          </StackPanel>
          <TextBlock Text="{Binding DeleteQuestion}" Foreground="{DynamicResource WarnFg}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" />
        </DockPanel>
      </Border>

      <ItemsControl ItemsSource="{Binding Routes}" Margin="0,0,-12,0">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><UniformGrid Columns="{Binding CardColumns}" x:DataType="vm:RoutesViewModel" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:RouteCardViewModel">
            <Border Classes="route" Classes.active="{Binding IsActive}" Tapped="OnRouteTapped" ToolTip.Tip="Щелчок — открыть редактор">
              <StackPanel Spacing="6">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Classes="icon" ToolTip.Tip="Действия с маршрутом" AutomationProperties.Name="Действия с маршрутом">
                    <v:Icon Data="{StaticResource IconMore}" Width="18" Height="18" Thickness="3" />
                    <Button.Flyout>
                      <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <MenuItem Header="Редактировать" Command="{Binding EditCommand}" />
                        <MenuItem Header="Дублировать" Command="{Binding DuplicateCommand}" />
                        <Separator IsVisible="{Binding IsCustom}" />
                        <MenuItem Header="Удалить…" Command="{Binding DeleteCommand}" IsVisible="{Binding IsCustom}" />
                      </MenuFlyout>
                    </Button.Flyout>
                  </Button>
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="16" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock Classes="hint" Text="{Binding Subtitle}" MaxLines="2" TextTrimming="CharacterEllipsis" />
                <DockPanel Margin="0,4,0,0">
                  <Button DockPanel.Dock="Left" Content="Включить" Command="{Binding ActivateCommand}" IsVisible="{Binding !IsActive}" />
                  <Border DockPanel.Dock="Left" Classes="pill" Background="{DynamicResource Accent}" IsVisible="{Binding IsActive}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <v:Icon Data="{StaticResource IconCheck}" Width="12" Height="12" Foreground="{DynamicResource AccentDark}" />
                      <TextBlock Text="Действует" Foreground="{DynamicResource AccentDark}" FontSize="12" FontWeight="SemiBold" />
                    </StackPanel>
                  </Border>
                  <TextBlock Text="{Binding KindLabel}" Classes="lbl" VerticalAlignment="Center" HorizontalAlignment="Right" />
                </DockPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Border Background="{DynamicResource BadBg}" CornerRadius="12" Padding="12" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}">
        <TextBlock Text="{Binding Error}" Foreground="{DynamicResource BadFg}" TextWrapping="Wrap" />
      </Border>

      <!-- Общее для всех маршрутов: свёрнуто -->
      <Expander HorizontalAlignment="Stretch" Header="Для всех маршрутов: QUIC, UDP, гео-базы, приложения Store">
        <StackPanel Spacing="4">
          <DockPanel Margin="0,6">
            <ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding Shared.BlockQuic}" OnContent="" OffContent="" />
            <Button DockPanel.Dock="Right" Classes="info" Margin="0,0,8,0" Command="{Binding ShowInfoCommand}" CommandParameter="blockQuic" />
            <StackPanel>
              <TextBlock Text="Блокировать QUIC (UDP 443)" TextWrapping="Wrap" />
              <TextBlock Classes="hint" Text="Браузер сразу уходит на TCP, сайты не «думают»" />
            </StackPanel>
          </DockPanel>
          <DockPanel Margin="0,6">
            <ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding Shared.UdpProxy}" OnContent="" OffContent="" />
            <Button DockPanel.Dock="Right" Classes="info" Margin="0,0,8,0" Command="{Binding ShowInfoCommand}" CommandParameter="udpProxy" />
            <StackPanel>
              <TextBlock Text="UDP через сервер" TextWrapping="Wrap" />
              <TextBlock Classes="hint" Text="Нужно для голоса Discord и звонков" />
            </StackPanel>
          </DockPanel>

          <!-- Гео-базы: правки закреплённых наборов действуют во всех маршрутах -->
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
            <TextBlock Classes="lbl" Text="ГЕО-БАЗЫ" VerticalAlignment="Center" />
            <Button Classes="info" Command="{Binding ShowInfoCommand}" CommandParameter="geoLists" />
          </StackPanel>
          <ItemsControl ItemsSource="{Binding Shared.GeoLists}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:GeoListRow">
                <Border Classes="row">
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Открыть" Command="{Binding OpenCommand}" VerticalAlignment="Center" Margin="12,0,0,0" />
                    <Border DockPanel.Dock="Right" Classes="pill" Background="{DynamicResource InfoBg}" VerticalAlignment="Center" IsVisible="{Binding IsEdited}">
                      <TextBlock Text="{Binding EditSummary}" Foreground="{DynamicResource InfoFg}" FontSize="12" />
                    </Border>
                    <StackPanel Spacing="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                      <TextBlock Classes="hint" Text="{Binding Description}" />
                    </StackPanel>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- Приложения Store: loopback-исключения (только режим «Только браузеры») -->
          <StackPanel Spacing="8" IsVisible="{Binding Shared.StoreAppsVisible}" Margin="0,12,0,0">
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="Показать приложения" Command="{Binding Shared.LoadStoreAppsCommand}" />
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Classes="lbl" Text="ПРИЛОЖЕНИЯ ИЗ MICROSOFT STORE" VerticalAlignment="Center" />
                <Button Classes="info" Command="{Binding ShowInfoCommand}" CommandParameter="uwpLoopback" />
              </StackPanel>
            </DockPanel>
            <TextBlock Classes="hint" Text="Отметьте приложения Store, которым нужен прокси: без разрешения они к нему не подключаются." />
            <TextBlock Classes="hint" Text="{Binding Shared.StoreAppsSummary}" />
            <TextBox Text="{Binding Shared.StoreFilter}" PlaceholderText="Поиск по названию" IsVisible="{Binding !!Shared.StoreApps.Count}" />
            <ScrollViewer MaxHeight="260" IsVisible="{Binding !!Shared.StoreApps.Count}">
              <ItemsControl ItemsSource="{Binding Shared.StoreApps}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:StoreAppViewModel">
                    <CheckBox IsChecked="{Binding IsChecked}" Content="{Binding Name}" Margin="0,2" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </StackPanel>

          <!-- От администратора подписки (ADR-048): только чтение -->
          <StackPanel Spacing="6" IsVisible="{Binding Shared.HasAdminRules}" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Classes="lbl" Text="ОТ АДМИНИСТРАТОРА ПОДПИСКИ" VerticalAlignment="Center" />
              <Button Classes="info" Command="{Binding ShowInfoCommand}" CommandParameter="adminSub" />
            </StackPanel>
            <TextBlock Classes="hint" Text="{Binding Shared.AdminRulesNote}" />
            <ItemsControl ItemsSource="{Binding Shared.AdminRules}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="4,3" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </Expander>
    </StackPanel>

    <!-- ================= Редактор маршрута справа ================= -->
    <Border Grid.Column="1" x:Name="Drawer" IsVisible="{Binding IsEditing}" Width="460" Margin="20,0,0,0" VerticalAlignment="Top"
            Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="16" Padding="18,16">
      <ContentControl Content="{Binding Editor}">
        <ContentControl.ContentTemplate>
          <DataTemplate x:DataType="vm:RouteEditorViewModel">
            <StackPanel Spacing="12">
              <DockPanel>
                <Button DockPanel.Dock="Right" Classes="icon" Command="{Binding CloseCommand}" ToolTip.Tip="Закрыть редактор (Esc)" AutomationProperties.Name="Закрыть редактор">
                  <v:Icon Data="{StaticResource IconClose}" Width="16" Height="16" />
                </Button>
                <Button DockPanel.Dock="Right" Classes="icon" ToolTip.Tip="Ещё" AutomationProperties.Name="Ещё действия с маршрутом">
                  <v:Icon Data="{StaticResource IconMore}" Width="18" Height="18" Thickness="3" />
                  <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                      <MenuItem Header="Дублировать" Command="{Binding DuplicateCommand}" />
                      <MenuItem Header="Справка: маршруты" Command="{Binding ShowInfoCommand}" CommandParameter="routes" />
                    </MenuFlyout>
                  </Button.Flyout>
                </Button>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  <Border Classes="pill" Background="{DynamicResource OkBg}" IsVisible="{Binding IsActive}" VerticalAlignment="Center">
                    <TextBlock Text="действует" Foreground="{DynamicResource OkFg}" FontSize="11" />
                  </Border>
                </StackPanel>
              </DockPanel>

              <TextBlock Classes="hint" Text="{x:Static vm:RouteEditorViewModel.BuiltInNote}" IsVisible="{Binding IsBuiltIn}" />
              <TextBlock Classes="hint" IsVisible="{Binding IsNew}"
                         Text="Новый маршрут: через сервер идёт только то, что вы добавите, остальное — напрямую. Включите его в списке, на главной или в трее." />

              <!-- Название и основа -->
              <Grid ColumnDefinitions="*,10,*" RowDefinitions="Auto,Auto" IsVisible="{Binding IsCustom}">
                <TextBlock Grid.Column="0" Classes="lbl" Text="НАЗВАНИЕ" Margin="0,0,0,4" />
                <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding Name}" MaxLength="48" PlaceholderText="Например, «Только 2ip»" />
                <TextBlock Grid.Column="2" Classes="lbl" Text="ВСЁ ОСТАЛЬНОЕ" Margin="0,0,0,4" />
                <ComboBox Grid.Row="1" Grid.Column="2" ItemsSource="{x:Static vm:RouteEditorViewModel.Bases}" SelectedIndex="{Binding BaseIndex}" HorizontalAlignment="Stretch"
                          AutomationProperties.Name="Основа маршрута" ToolTip.Tip="{Binding BaseDescription}" />
              </Grid>

              <TabControl Padding="0" Margin="0,4,0,0">
                <!-- Сайты и программы -->
                <TabItem Header="Сайты и программы">
                  <StackPanel Spacing="10" Margin="0,10,0,0">
                    <DockPanel>
                      <Button DockPanel.Dock="Right" Classes="primary" Content="Добавить" Command="{Binding AddItemCommand}" Margin="8,0,0,0" />
                      <Button DockPanel.Dock="Right" Classes="icon" Command="{Binding RefreshRunningAppsCommand}" ToolTip.Tip="Обновить список запущенных программ"
                              Margin="6,0,0,0" AutomationProperties.Name="Обновить список запущенных программ">
                        <v:Icon Data="{StaticResource IconRefresh}" />
                      </Button>
                      <AutoCompleteBox Text="{Binding NewItem}" ItemsSource="{Binding RunningApps}" FilterMode="Contains" MinimumPrefixLength="0"
                                       PlaceholderText="2ip.io, Discord.exe или IP" />
                    </DockPanel>
                    <Border Background="{DynamicResource WarnBg}" CornerRadius="10" Padding="10,8" IsVisible="{Binding AppRulesNote, Converter={x:Static ObjectConverters.IsNotNull}}">
                      <TextBlock Text="{Binding AppRulesNote}" Foreground="{DynamicResource WarnFg}" TextWrapping="Wrap" />
                    </Border>
                    <Border Background="{DynamicResource InfoBg}" CornerRadius="10" Padding="10,8" IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}">
                      <TextBlock Text="{Binding Message}" Foreground="{DynamicResource InfoFg}" TextWrapping="Wrap" />
                    </Border>
                    <Border Background="{DynamicResource BadBg}" CornerRadius="10" Padding="10,8" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}">
                      <TextBlock Text="{Binding Error}" Foreground="{DynamicResource BadFg}" TextWrapping="Wrap" />
                    </Border>

                    <ItemsControl ItemsSource="{Binding Items}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:RuleItemViewModel">
                          <Border Classes="row">
                            <StackPanel Spacing="8">
                              <DockPanel>
                                <Button DockPanel.Dock="Right" Classes="icon" Command="{Binding RemoveCommand}" ToolTip.Tip="Убрать из маршрута" AutomationProperties.Name="Убрать из маршрута" Margin="4,0,0,0">
                                  <v:Icon Data="{StaticResource IconClose}" Width="14" Height="14" />
                                </Button>
                                <ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding Enabled}" OnContent="" OffContent="" MinWidth="0" ToolTip.Tip="Включить или выключить пункт" />
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" VerticalAlignment="Center" MaxWidth="240" />
                                  <TextBlock Text="{Binding Kind}" Classes="lbl" VerticalAlignment="Center" />
                                  <TextBlock Text="{Binding CountText}" Classes="lbl" VerticalAlignment="Center" IsVisible="{Binding CountText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                </StackPanel>
                              </DockPanel>
                              <Grid ColumnDefinitions="Auto,*,Auto,*">
                                <TextBlock Grid.Column="0" Classes="lbl" Text="TCP" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:RuleItemViewModel.Actions}" SelectedIndex="{Binding TcpIndex}" HorizontalAlignment="Stretch" AutomationProperties.Name="TCP" />
                                <TextBlock Grid.Column="2" Classes="lbl" Text="UDP" VerticalAlignment="Center" Margin="10,0,6,0" />
                                <ComboBox Grid.Column="3" ItemsSource="{x:Static vm:RuleItemViewModel.Actions}" SelectedIndex="{Binding UdpIndex}" HorizontalAlignment="Stretch" AutomationProperties.Name="UDP" />
                              </Grid>
                              <ComboBox ItemsSource="{Binding Servers}" SelectedIndex="{Binding ServerIndex}" IsVisible="{Binding ShowServer}" HorizontalAlignment="Stretch"
                                        ToolTip.Tip="Через какой сервер идёт этот пункт" AutomationProperties.Name="Сервер пункта" />
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Classes="hint" IsVisible="{Binding !HasItems}"
                               Text="Пока пусто. Например: 2ip.io — через сервер «Германия», Discord.exe — TCP и UDP через сервер." />
                  </StackPanel>
                </TabItem>

                <!-- Ещё: наборы гео-баз и свои списки -->
                <TabItem Header="Ещё">
                  <StackPanel Spacing="10" Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Classes="lbl" Text="НАБОР ИЗ ГЕО-БАЗ" VerticalAlignment="Center" />
                      <Button Classes="info" Command="{Binding ShowInfoCommand}" CommandParameter="routeGeoImport" />
                    </StackPanel>
                    <DockPanel>
                      <Button DockPanel.Dock="Right" Content="Добавить" Command="{Binding AddGeoSetCommand}" Margin="8,0,0,0" />
                      <ComboBox ItemsSource="{Binding GeoSets}" SelectedIndex="{Binding GeoSetIndex}" HorizontalAlignment="Stretch" AutomationProperties.Name="Набор гео-базы" />
                    </DockPanel>
                    <TextBlock Classes="hint" Text="Например, «Госсайты» или «Банки» напрямую. Пункт появится на вкладке «Сайты и программы»." />

                    <DockPanel Margin="0,14,0,0">
                      <Button DockPanel.Dock="Right" Content="Создать список" Command="{Binding CreateListCommand}" VerticalAlignment="Center" />
                      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Classes="lbl" Text="СВОИ СПИСКИ" VerticalAlignment="Center" />
                        <Button Classes="info" Command="{Binding ShowInfoCommand}" CommandParameter="geoLists" />
                      </StackPanel>
                    </DockPanel>
                    <TextBlock Classes="hint" Text="Маски, поддомены, слова, выражения, сети. Список из v2rayN вставляется как есть. Выше — главнее." />
                    <ItemsControl ItemsSource="{Binding Lists}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:GeoListRow">
                          <Border Classes="row">
                            <DockPanel>
                              <Button DockPanel.Dock="Right" Content="Открыть" Command="{Binding OpenCommand}" VerticalAlignment="Center" Margin="8,0,0,0" />
                              <Button DockPanel.Dock="Right" Classes="icon" Command="{Binding MoveDownCommand}" IsEnabled="{Binding CanMoveDown}" VerticalAlignment="Center"
                                      ToolTip.Tip="Ниже — проверяется позже" AutomationProperties.Name="Опустить список">
                                <v:Icon Data="{StaticResource IconDown}" Width="14" Height="14" />
                              </Button>
                              <Button DockPanel.Dock="Right" Classes="icon" Command="{Binding MoveUpCommand}" IsEnabled="{Binding CanMoveUp}" VerticalAlignment="Center"
                                      ToolTip.Tip="Выше — главнее: проверяется раньше" AutomationProperties.Name="Поднять список">
                                <v:Icon Data="{StaticResource IconUp}" Width="14" Height="14" />
                              </Button>
                              <StackPanel Spacing="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Classes="hint"><Run Text="{Binding Kind}" /><Run Text=" · " /><Run Text="{Binding Description}" /></TextBlock>
                              </StackPanel>
                            </DockPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </TabItem>
              </TabControl>
            </StackPanel>
          </DataTemplate>
        </ContentControl.ContentTemplate>
      </ContentControl>
    </Border>
  </Grid>
</UserControl>
