<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Tropa.App.ViewModels"
        xmlns:v="using:Tropa.App.Views"
        x:Class="Tropa.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Тропа"
        Icon="/Assets/tropa.ico"
        Width="1180" Height="780" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen">
  <Window.DataTemplates>
    <DataTemplate DataType="vm:HomeViewModel"><v:HomeView /></DataTemplate>
    <DataTemplate DataType="vm:ServersViewModel"><v:ServersView /></DataTemplate>
    <DataTemplate DataType="vm:RulesViewModel"><v:RulesView /></DataTemplate>
    <DataTemplate DataType="vm:DiagnosticsViewModel"><v:DiagnosticsView /></DataTemplate>
    <DataTemplate DataType="vm:SettingsViewModel"><v:SettingsView /></DataTemplate>
    <DataTemplate DataType="vm:PlaceholderViewModel"><v:PlaceholderView /></DataTemplate>
  </Window.DataTemplates>

  <Panel>
    <Grid ColumnDefinitions="232,*">
      <!-- Боковое меню -->
      <Border Grid.Column="0" Background="{DynamicResource Side}" BorderBrush="{DynamicResource SideLine}" BorderThickness="0,0,1,0" Padding="14,20">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="10,4,10,20">
              <Image Source="/Assets/logo.png" Width="28" Height="28" />
              <TextBlock Text="Тропа" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
            </StackPanel>
            <Button Classes="nav" Classes.on="{Binding IsHome}" Content="Главная" Command="{Binding NavigateCommand}" CommandParameter="home" />
            <Button Classes="nav" Classes.on="{Binding IsServers}" Content="Серверы" Command="{Binding NavigateCommand}" CommandParameter="servers" />
            <Button Classes="nav" Classes.on="{Binding IsRules}" Content="Правила" Command="{Binding NavigateCommand}" CommandParameter="rules" />
            <Button Classes="nav" Classes.on="{Binding IsDiagnostics}" Content="Диагностика" Command="{Binding NavigateCommand}" CommandParameter="diagnostics" />
            <Button Classes="nav" Classes.on="{Binding IsSettings}" Content="Настройки" Command="{Binding NavigateCommand}" CommandParameter="settings" />
          </StackPanel>
          <Border DockPanel.Dock="Bottom" VerticalAlignment="Bottom" Background="{DynamicResource SideFooter}" CornerRadius="12" Padding="12">
            <StackPanel Spacing="4">
              <TextBlock Text="{Binding FooterStatus}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding CoreVersions}" Classes="muted" />
            </StackPanel>
          </Border>
        </DockPanel>
      </Border>

      <!-- Содержимое -->
      <DockPanel Grid.Column="1">
        <Border DockPanel.Dock="Top" IsVisible="{Binding Warning, Converter={x:Static ObjectConverters.IsNotNull}}"
                Background="{DynamicResource WarnBg}" Padding="16,10" Margin="36,20,36,0" CornerRadius="12">
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="Понятно" Command="{Binding DismissWarningCommand}" />
            <TextBlock Text="{Binding Warning}" Foreground="{DynamicResource WarnFg}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
          </DockPanel>
        </Border>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <ContentControl Content="{Binding CurrentPage}" Margin="36,28" />
        </ScrollViewer>
      </DockPanel>
    </Grid>

    <!-- Первый запуск -->
    <Border IsVisible="{Binding Onboarding.IsOpen}" Background="{DynamicResource Overlay}">
      <Border Classes="card" Width="620" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="16">
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="Пропустить" Command="{Binding Onboarding.FinishCommand}" />
            <StackPanel Spacing="4">
              <TextBlock Classes="h1" Text="Добро пожаловать в Тропу" />
              <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding Onboarding.Subtitle}" />
            </StackPanel>
          </DockPanel>

          <StackPanel Spacing="12" IsVisible="{Binding Onboarding.IsStep0}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="Настроить Тропу автоматически?" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
              <Button Classes="info" Command="{Binding Onboarding.ShowInfoCommand}" CommandParameter="autoSetup" />
            </StackPanel>
            <TextBlock Classes="muted" TextWrapping="Wrap"
                       Text="Тропа включит рекомендуемые настройки: весь компьютер через Тропу, запуск вместе с Windows и автоподключение, выбор самого быстрого сервера, через сервер — только заблокированные сайты, защита DNS. Вам останется только вставить ссылку от продавца VPN. Всё можно поменять потом в «Настройках»." />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
              <Button Content="Нет, настрою сам" Command="{Binding Onboarding.ChooseManualCommand}" />
              <Button Classes="primary" Content="Да, настроить автоматически" Command="{Binding Onboarding.ChooseAutoCommand}" />
            </StackPanel>
          </StackPanel>

          <StackPanel Spacing="10" IsVisible="{Binding Onboarding.IsStep1}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="1. Ссылка подписки" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
              <Button Classes="info" Command="{Binding Onboarding.ShowInfoCommand}" CommandParameter="subscription" />
            </StackPanel>
            <TextBlock Classes="muted" TextWrapping="Wrap" Text="Её даёт продавец VPN: адрес https://… или ссылки vless://, vmess://, trojan://, ss://, hysteria2://." />
            <TextBox Text="{Binding Onboarding.Text}" AcceptsReturn="True" TextWrapping="Wrap" Height="90"
                     FontFamily="{StaticResource Mono}" PlaceholderText="https://… или vless://…" />
            <Button Classes="primary" Content="{Binding Onboarding.AddLabel}" Command="{Binding Onboarding.ImportCommand}" HorizontalAlignment="Right" />
          </StackPanel>

          <StackPanel Spacing="10" IsVisible="{Binding Onboarding.IsStep2}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="2. Что пускать через Тропу" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
              <Button Classes="info" Command="{Binding Onboarding.ShowInfoCommand}" CommandParameter="mode" />
            </StackPanel>
            <RadioButton GroupName="onbMode" IsChecked="{Binding Onboarding.ModeTun}" IsEnabled="{Binding Onboarding.TunAvailable}" Content="Весь компьютер — игры, Discord, все программы" />
            <RadioButton GroupName="onbMode" IsChecked="{Binding !Onboarding.ModeTun}" Content="Только браузеры — через прокси Windows" />
            <TextBlock Classes="muted" Text="{Binding Onboarding.ModeNote}" />
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
              <TextBlock Text="Что пускать через сервер" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
              <Button Classes="info" Command="{Binding Onboarding.ShowInfoCommand}" CommandParameter="route" />
            </StackPanel>
            <RadioButton GroupName="onbRoute" IsChecked="{Binding Onboarding.RouteBlockedOnly}" Content="Только заблокированное (рекомендуется) — остальное работает как без VPN" />
            <RadioButton GroupName="onbRoute" IsChecked="{Binding !Onboarding.RouteBlockedOnly}" Content="Всё, кроме российского" />
            <CheckBox IsChecked="{Binding Onboarding.Autostart}" Content="Запускать вместе с Windows и сразу подключаться" Margin="0,6,0,0" />
            <Button Classes="primary" Content="Дальше" Command="{Binding Onboarding.NextCommand}" HorizontalAlignment="Right" />
          </StackPanel>

          <StackPanel Spacing="10" IsVisible="{Binding Onboarding.IsStep3}">
            <TextBlock Text="3. Подключение" FontSize="17" FontWeight="SemiBold" />
            <TextBlock Classes="muted" Text="Тропа проверит серверы и подключится к самому быстрому из рабочих." />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
              <Button Content="Подключусь сам" Command="{Binding Onboarding.FinishCommand}" />
              <Button Classes="primary" Content="Подключиться" Command="{Binding Onboarding.ConnectCommand}" />
            </StackPanel>
          </StackPanel>

          <TextBlock Text="{Binding Onboarding.Message}" TextWrapping="Wrap" Foreground="{DynamicResource WarnFg}"
                     IsVisible="{Binding Onboarding.Message, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>
      </Border>
    </Border>

    <!-- Окно «Добавить серверы» -->
    <Border IsVisible="{Binding Import.IsOpen}" Background="{DynamicResource Overlay}">
      <Border Classes="card" Width="680" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24">
        <StackPanel Spacing="14">
          <DockPanel>
            <Button DockPanel.Dock="Right" Width="40" Command="{Binding Import.CloseCommand}" ToolTip.Tip="Закрыть" AutomationProperties.Name="Закрыть">
<v:Icon Data="{StaticResource IconClose}" />
</Button>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="Добавить серверы" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
              <Button Classes="info" Command="{Binding Import.ShowInfoCommand}" CommandParameter="importMethods" ToolTip.Tip="Что можно вставить" />
            </StackPanel>
          </DockPanel>
          <TextBlock Classes="muted" Text="Вставьте адрес подписки (https://…) или одну или несколько ссылок vless://, vmess://, trojan://. Ctrl+V в любом месте окна тоже работает." />
          <TextBox Text="{Binding Import.Text}" AcceptsReturn="True" TextWrapping="Wrap" Height="140" FontFamily="{StaticResource Mono}" PlaceholderText="https://… или vless://…" />
          <StackPanel Spacing="6" IsVisible="{Binding Import.LooksLikeSubscription}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="Название подписки (необязательно)" Classes="lbl" VerticalAlignment="Center" />
              <Button Classes="info" Command="{Binding Import.ShowInfoCommand}" CommandParameter="subUrl" ToolTip.Tip="Что такое адрес подписки" />
            </StackPanel>
            <TextBox Text="{Binding Import.Name}" PlaceholderText="Например, «Провайдер»" />
          </StackPanel>
          <Border IsVisible="{Binding Import.HasResult}" Background="{DynamicResource InfoBg}" CornerRadius="12" Padding="12">
            <TextBlock Text="{Binding Import.Result}" Foreground="{DynamicResource InfoFg}" TextWrapping="Wrap" />
          </Border>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <ProgressBar IsIndeterminate="True" Width="80" IsVisible="{Binding Import.IsBusy}" />
            <Button Content="Отмена" Command="{Binding Import.CloseCommand}" />
            <Button Classes="primary" Content="Добавить" Command="{Binding Import.ImportCommand}" IsEnabled="{Binding !Import.IsBusy}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

    <!-- Окно «Сервер» -->
    <Border IsVisible="{Binding Edit.IsOpen}" Background="{DynamicResource Overlay}">
      <v:EditServerView DataContext="{Binding Edit}" />
    </Border>

    <!-- Окно «Гео-база» (ADR-039): большие списки — только виртуализированный ListBox -->
    <Border IsVisible="{Binding GeoEditor.IsOpen}" Background="{DynamicResource Overlay}">
      <Border Classes="card" MaxWidth="820" Margin="40,32" Padding="24" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
          <DockPanel Grid.Row="0">
            <Button DockPanel.Dock="Right" Width="40" Command="{Binding GeoEditor.CloseCommand}" ToolTip.Tip="Закрыть без сохранения" AutomationProperties.Name="Закрыть">
<v:Icon Data="{StaticResource IconClose}" />
</Button>
            <StackPanel Spacing="4" Margin="0,0,12,0">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="{Binding GeoEditor.Title}" FontSize="21" FontWeight="Bold" VerticalAlignment="Center" />
                <Button Classes="info" Command="{Binding GeoEditor.ShowInfoCommand}" CommandParameter="geoLists" />
              </StackPanel>
              <TextBlock Classes="muted" Text="{Binding GeoEditor.Description}" />
              <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,10,0,0" IsVisible="{Binding GeoEditor.IsCustom}">
                <TextBox Grid.Column="0" Text="{Binding GeoEditor.ListName}" PlaceholderText="Название, например «Игры»" MaxLength="64" />
                <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:GeoListEditorViewModel.Actions}" SelectedIndex="{Binding GeoEditor.ActionIndex}" MinWidth="170" Margin="8,0,0,0" ToolTip.Tip="Что делать с сайтами и адресами из списка" />
                <ToggleSwitch Grid.Column="2" IsChecked="{Binding GeoEditor.ListEnabled}" OnContent="Вкл" OffContent="Выкл" Margin="12,0,0,0" VerticalAlignment="Center" />
              </Grid>
            </StackPanel>
          </DockPanel>

          <!-- Проверка адреса -->
          <StackPanel Grid.Row="1" Spacing="8" Margin="0,16,0,0">
            <DockPanel>
              <Button DockPanel.Dock="Right" Classes="primary" Content="Добавить…" Command="{Binding GeoEditor.OpenAddCommand}" IsEnabled="{Binding !GeoEditor.IsBusy}" Margin="8,0,0,0" />
              <Button DockPanel.Dock="Right" Content="Проверить" Command="{Binding GeoEditor.CheckCommand}" IsEnabled="{Binding !GeoEditor.IsBusy}" IsDefault="{Binding GeoEditor.IsOpen}" Margin="8,0,0,0" />
              <TextBox Text="{Binding GeoEditor.CheckText}" PlaceholderText="{Binding GeoEditor.CheckPlaceholder}" />
            </DockPanel>
            <Border Background="{DynamicResource OkBg}" CornerRadius="10" Padding="10,8" IsVisible="{Binding GeoEditor.CheckHit}">
              <SelectableTextBlock Text="{Binding GeoEditor.CheckResult}" Foreground="{DynamicResource OkFg}" TextWrapping="Wrap" />
            </Border>
            <Border Background="{DynamicResource Card2}" CornerRadius="10" Padding="10,8" IsVisible="{Binding GeoEditor.CheckMiss}">
              <SelectableTextBlock Text="{Binding GeoEditor.CheckResult}" TextWrapping="Wrap" />
            </Border>
            <Border Background="{DynamicResource WarnBg}" CornerRadius="10" Padding="10,8" IsVisible="{Binding GeoEditor.CheckBad}">
              <TextBlock Text="{Binding GeoEditor.CheckResult}" Foreground="{DynamicResource WarnFg}" TextWrapping="Wrap" />
            </Border>
          </StackPanel>

          <!-- Поиск и вид -->
          <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <ComboBox DockPanel.Dock="Right" ItemsSource="{x:Static vm:GeoListEditorViewModel.Views}" SelectedIndex="{Binding GeoEditor.ViewIndex}" MinWidth="180" Margin="8,0,0,0" />
            <TextBox Text="{Binding GeoEditor.Filter}" PlaceholderText="Поиск по списку" />
          </DockPanel>

          <StackPanel Grid.Row="3" Spacing="8" Margin="0,10,0,6">
            <DockPanel>
              <ProgressBar DockPanel.Dock="Right" IsIndeterminate="True" Width="80" IsVisible="{Binding GeoEditor.IsBusy}" VerticalAlignment="Center" />
              <TextBlock Classes="muted" Text="{Binding GeoEditor.Summary}" VerticalAlignment="Center" />
            </DockPanel>
            <Border Background="{DynamicResource InfoBg}" CornerRadius="10" Padding="10,8" IsVisible="{Binding GeoEditor.Message, Converter={x:Static ObjectConverters.IsNotNull}}">
              <TextBlock Text="{Binding GeoEditor.Message}" Foreground="{DynamicResource InfoFg}" TextWrapping="Wrap" />
            </Border>
            <Border Background="{DynamicResource BadBg}" CornerRadius="10" Padding="10,8" IsVisible="{Binding GeoEditor.Error, Converter={x:Static ObjectConverters.IsNotNull}}">
              <TextBlock Text="{Binding GeoEditor.Error}" Foreground="{DynamicResource BadFg}" TextWrapping="Wrap" />
            </Border>
          </StackPanel>

          <Border Grid.Row="4" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
            <Panel>
              <ListBox ItemsSource="{Binding GeoEditor.Items}" Background="Transparent" SelectionMode="Single">
                <ListBox.Styles>
                  <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="12,0,6,0" />
                    <Setter Property="Height" Value="38" />
                  </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:GeoEntryRow">
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" VerticalAlignment="Center">
                      <SelectableTextBlock Grid.Column="0" Text="{Binding Value}" FontFamily="{StaticResource Mono}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      <Border Grid.Column="1" Classes="pill" Background="{DynamicResource OkBg}" IsVisible="{Binding IsAdded}" VerticalAlignment="Center" Margin="8,0,0,0">
                        <TextBlock Text="добавлено" Foreground="{DynamicResource OkFg}" FontSize="12" />
                      </Border>
                      <Border Grid.Column="1" Classes="pill" Background="{DynamicResource WarnBg}" IsVisible="{Binding IsRemoved}" VerticalAlignment="Center" Margin="8,0,0,0">
                        <TextBlock Text="убрано" Foreground="{DynamicResource WarnFg}" FontSize="12" />
                      </Border>
                      <TextBlock Grid.Column="2" Classes="lbl" Text="{Binding KindLabel}" VerticalAlignment="Center" Margin="12,0,12,0" />
                      <Button Grid.Column="3" Width="32" Height="30" MinHeight="30" Padding="0" Background="Transparent"
                              Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).GeoEditor.ToggleCommand}" CommandParameter="{Binding}"
                              ToolTip.Tip="{Binding ActionTip}" AutomationProperties.Name="{Binding ActionTip}">
                        <Panel>
                          <v:Icon Data="{StaticResource IconClose}" Width="14" Height="14" IsVisible="{Binding !IsRemoved}" />
                          <v:Icon Data="{StaticResource IconUndo}" Width="14" Height="14" IsVisible="{Binding IsRemoved}" />
                        </Panel>
                      </Button>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <TextBlock Classes="muted" Text="{Binding GeoEditor.EmptyText}" IsVisible="{Binding GeoEditor.IsEmpty}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Panel>
          </Border>

          <DockPanel Grid.Row="5" Margin="0,16,0,0">
            <Button DockPanel.Dock="Left" Content="Сбросить мои правки" Command="{Binding GeoEditor.ResetEditsCommand}" IsEnabled="{Binding !GeoEditor.IsBusy}" IsVisible="{Binding GeoEditor.IsBuiltIn}" />
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="8" IsVisible="{Binding GeoEditor.IsCustom}">
              <Button Content="Удалить список" Command="{Binding GeoEditor.DeleteListCommand}" IsVisible="{Binding !GeoEditor.ConfirmDelete}" />
              <Button Content="Точно удалить?" Command="{Binding GeoEditor.DeleteListCommand}" IsVisible="{Binding GeoEditor.ConfirmDelete}"
                      Background="{DynamicResource BadBg}" Foreground="{DynamicResource BadFg}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
              <Button Content="Отмена" Command="{Binding GeoEditor.CloseCommand}" />
              <Button Classes="primary" Content="Сохранить" Command="{Binding GeoEditor.SaveCommand}" IsEnabled="{Binding GeoEditor.CanSave}" />
            </StackPanel>
          </DockPanel>
        </Grid>
      </Border>
    </Border>

    <!-- Окно «Добавить записи» поверх окна гео-базы -->
    <Border IsVisible="{Binding GeoEditor.IsAddOpen}" Background="{DynamicResource Overlay}">
      <Border Classes="card" Width="640" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="14">
          <DockPanel>
            <Button DockPanel.Dock="Right" Width="40" Command="{Binding GeoEditor.CloseAddCommand}" ToolTip.Tip="Закрыть" AutomationProperties.Name="Закрыть добавление">
<v:Icon Data="{StaticResource IconClose}" />
</Button>
            <StackPanel Spacing="4" Margin="0,0,12,0">
              <TextBlock Text="Добавить записи" FontSize="20" FontWeight="Bold" />
              <TextBlock Classes="muted" Text="{Binding GeoEditor.Title, StringFormat='В список «{0}»'}" />
            </StackPanel>
          </DockPanel>

          <StackPanel Spacing="6">
            <TextBlock Classes="lbl" Text="ЧТО ДОБАВИТЬ" />
            <ComboBox ItemsSource="{Binding GeoEditor.AddKinds}" SelectedItem="{Binding GeoEditor.AddKind}" HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:GeoKindOption">
                  <TextBlock Text="{Binding Title}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Border Background="{DynamicResource Card2}" CornerRadius="10" Padding="12,10">
              <StackPanel Spacing="4">
                <TextBlock Text="{Binding GeoEditor.AddKind.Rule}" TextWrapping="Wrap" />
                <TextBlock Classes="muted" FontFamily="{StaticResource Mono}" Text="{Binding GeoEditor.AddKind.Example, StringFormat='Пример: {0}'}" />
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel Spacing="6">
            <TextBlock Classes="lbl" Text="ЗАПИСИ — МОЖНО НЕСКОЛЬКО, КАЖДУЮ С НОВОЙ СТРОКИ" />
            <TextBox Text="{Binding GeoEditor.NewText}" PlaceholderText="{Binding GeoEditor.AddKind.Placeholder}" FontFamily="{StaticResource Mono}"
                     AcceptsReturn="True" TextWrapping="Wrap" Height="140" />
          </StackPanel>

          <Border Background="{DynamicResource BadBg}" CornerRadius="10" Padding="10,8" IsVisible="{Binding GeoEditor.AddError, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="{Binding GeoEditor.AddError}" Foreground="{DynamicResource BadFg}" TextWrapping="Wrap" />
          </Border>

          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="Отмена" Command="{Binding GeoEditor.CloseAddCommand}" />
            <Button Classes="primary" Content="Добавить" Command="{Binding GeoEditor.AddCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

    <!-- Справка по кнопке «i» -->
    <Border IsVisible="{Binding Info.IsOpen}" Background="{DynamicResource Overlay}" PointerPressed="OnInfoBackdropPressed">
      <Border Classes="card" Width="580" MaxHeight="640" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24" PointerPressed="OnInfoCardPressed">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Width="40" Command="{Binding Info.CloseCommand}" ToolTip.Tip="Закрыть" AutomationProperties.Name="Закрыть">
<v:Icon Data="{StaticResource IconClose}" />
</Button>
            <TextBlock Text="{Binding Info.Title}" FontSize="21" FontWeight="Bold" TextWrapping="Wrap" />
          </DockPanel>
          <Button DockPanel.Dock="Bottom" HorizontalAlignment="Right" Content="Понятно" Margin="0,16,0,0" Command="{Binding Info.CloseCommand}" />
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="6" Margin="0,0,16,0">
              <Border IsVisible="{Binding Info.Now, Converter={x:Static ObjectConverters.IsNotNull}}" Background="{DynamicResource WarnBg}" CornerRadius="12" Padding="12,10">
                <TextBlock Text="{Binding Info.Now}" Foreground="{DynamicResource WarnFg}" TextWrapping="Wrap" />
              </Border>
              <StackPanel IsVisible="{Binding Info.What, Converter={x:Static ObjectConverters.IsNotNull}}" Spacing="4" Margin="0,8,0,0">
                <TextBlock Classes="lbl" Text="ЧТО ЭТО" />
                <TextBlock Text="{Binding Info.What}" TextWrapping="Wrap" LineHeight="22" />
              </StackPanel>
              <StackPanel IsVisible="{Binding Info.Why, Converter={x:Static ObjectConverters.IsNotNull}}" Spacing="4" Margin="0,8,0,0">
                <TextBlock Classes="lbl" Text="ЗАЧЕМ НУЖНО" />
                <TextBlock Text="{Binding Info.Why}" TextWrapping="Wrap" LineHeight="22" />
              </StackPanel>
              <Border IsVisible="{Binding Info.Dpi, Converter={x:Static ObjectConverters.IsNotNull}}" Background="{DynamicResource DpiBg}" CornerRadius="12" Padding="14,10" Margin="0,10,0,0">
                <StackPanel Spacing="4">
                  <TextBlock Classes="lbl" Foreground="{DynamicResource OkFg}" Text="КАК ПОМОГАЕТ ПРОТИВ БЛОКИРОВОК" />
                  <TextBlock Text="{Binding Info.Dpi}" TextWrapping="Wrap" LineHeight="22" />
                </StackPanel>
              </Border>
              <StackPanel IsVisible="{Binding Info.Risk, Converter={x:Static ObjectConverters.IsNotNull}}" Spacing="4" Margin="0,8,0,0">
                <TextBlock Classes="lbl" Text="ПОДВОДНЫЕ КАМНИ" />
                <TextBlock Text="{Binding Info.Risk}" TextWrapping="Wrap" LineHeight="22" />
              </StackPanel>
              <Border IsVisible="{Binding Info.Conf, Converter={x:Static ObjectConverters.IsNotNull}}" Background="{DynamicResource InfoBg}" CornerRadius="12" Padding="14,10" Margin="0,10,0,0">
                <StackPanel Spacing="4">
                  <TextBlock Classes="lbl" Foreground="{DynamicResource InfoFg}" Text="СОВМЕСТИМОСТЬ" />
                  <TextBlock Text="{Binding Info.Conf}" TextWrapping="Wrap" LineHeight="22" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Border>
  </Panel>
</Window>
