<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Tropa.App.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <!-- Палитры тёмной и светлой темы (design/canvas-src). Ключи одинаковые: виды берут их через
           DynamicResource, поэтому тема меняется сразу, без перезапуска. -->
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="Bg" Color="#0F1215" />
          <SolidColorBrush x:Key="Side" Color="#14181C" />
          <SolidColorBrush x:Key="Card" Color="#171B20" />
          <SolidColorBrush x:Key="Card2" Color="#1E242A" />
          <SolidColorBrush x:Key="Line" Color="#242A31" />
          <SolidColorBrush x:Key="Text" Color="#E6EAEE" />
          <SolidColorBrush x:Key="Muted" Color="#9AA4AE" />
          <SolidColorBrush x:Key="Accent" Color="#3DDC97" />
          <SolidColorBrush x:Key="AccentDark" Color="#0B1A13" />
          <SolidColorBrush x:Key="AccentHover" Color="#5BE6A8" />
          <SolidColorBrush x:Key="OkBg" Color="#173A2B" />
          <SolidColorBrush x:Key="OkFg" Color="#7BE8B5" />
          <SolidColorBrush x:Key="WarnBg" Color="#3A2E14" />
          <SolidColorBrush x:Key="WarnFg" Color="#F5C76A" />
          <SolidColorBrush x:Key="BadBg" Color="#3D1C1F" />
          <SolidColorBrush x:Key="BadFg" Color="#FF9C9C" />
          <SolidColorBrush x:Key="InfoBg" Color="#152233" />
          <SolidColorBrush x:Key="InfoFg" Color="#9CC4FF" />
          <SolidColorBrush x:Key="DpiBg" Color="#132A20" />
          <SolidColorBrush x:Key="Label" Color="#8E99A4" />
          <SolidColorBrush x:Key="NavFg" Color="#A3ADB7" />
          <SolidColorBrush x:Key="NavOnBg" Color="#1E2A25" />
          <SolidColorBrush x:Key="FieldBorder" Color="#2C333B" />
          <SolidColorBrush x:Key="InfoBorder" Color="#3A424B" />
          <SolidColorBrush x:Key="Overlay" Color="#BB050709" />
          <SolidColorBrush x:Key="SideLine" Color="#232930" />
          <SolidColorBrush x:Key="SideFooter" Color="#1A1F24" />
          <SolidColorBrush x:Key="Chip" Color="#2A323A" />
          <SolidColorBrush x:Key="PowerOff" Color="#232A31" />
          <!-- Кнопка подключения по состояниям: приглушённые, не кислотные. -->
          <SolidColorBrush x:Key="PowerOn" Color="#2E7D5B" />
          <SolidColorBrush x:Key="PowerOnFg" Color="#E8F5EE" />
          <SolidColorBrush x:Key="PowerBusy" Color="#7A6332" />
          <SolidColorBrush x:Key="PowerBusyFg" Color="#F6EBD3" />
          <SolidColorBrush x:Key="PowerErr" Color="#7E3A3D" />
          <SolidColorBrush x:Key="PowerErrFg" Color="#F8E1E2" />
          <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#3DDC97" />
          <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#5BE6A8" />
          <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#2FBF80" />
          <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#0B1A13" />
          <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#0B1A13" />
          <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#0B1A13" />
          <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="#2C333B" />
          <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#3A424B" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="Bg" Color="#F3F5F7" />
          <SolidColorBrush x:Key="Side" Color="#E9EDF1" />
          <SolidColorBrush x:Key="Card" Color="#FFFFFF" />
          <SolidColorBrush x:Key="Card2" Color="#EEF1F4" />
          <SolidColorBrush x:Key="Line" Color="#DCE2E8" />
          <SolidColorBrush x:Key="Text" Color="#161B20" />
          <SolidColorBrush x:Key="Muted" Color="#55616C" />
          <SolidColorBrush x:Key="Accent" Color="#15A066" />
          <SolidColorBrush x:Key="AccentDark" Color="#FFFFFF" />
          <SolidColorBrush x:Key="AccentHover" Color="#1DB876" />
          <SolidColorBrush x:Key="OkBg" Color="#DDF4E8" />
          <SolidColorBrush x:Key="OkFg" Color="#0F6B43" />
          <SolidColorBrush x:Key="WarnBg" Color="#FFF1D2" />
          <SolidColorBrush x:Key="WarnFg" Color="#7A4E00" />
          <SolidColorBrush x:Key="BadBg" Color="#FDE2E2" />
          <SolidColorBrush x:Key="BadFg" Color="#A3201A" />
          <SolidColorBrush x:Key="InfoBg" Color="#E2ECFB" />
          <SolidColorBrush x:Key="InfoFg" Color="#1B4F9C" />
          <SolidColorBrush x:Key="DpiBg" Color="#DDF4E8" />
          <SolidColorBrush x:Key="Label" Color="#5F6B77" />
          <SolidColorBrush x:Key="NavFg" Color="#45515C" />
          <SolidColorBrush x:Key="NavOnBg" Color="#D7EEE2" />
          <SolidColorBrush x:Key="FieldBorder" Color="#C6CED6" />
          <SolidColorBrush x:Key="InfoBorder" Color="#B3BDC7" />
          <SolidColorBrush x:Key="Overlay" Color="#88101418" />
          <SolidColorBrush x:Key="SideLine" Color="#D6DCE2" />
          <SolidColorBrush x:Key="SideFooter" Color="#DFE4E9" />
          <SolidColorBrush x:Key="Chip" Color="#DDE3E8" />
          <SolidColorBrush x:Key="PowerOff" Color="#E3E8ED" />
          <SolidColorBrush x:Key="PowerOn" Color="#5FAE88" />
          <SolidColorBrush x:Key="PowerOnFg" Color="#FFFFFF" />
          <SolidColorBrush x:Key="PowerBusy" Color="#D2B26E" />
          <SolidColorBrush x:Key="PowerBusyFg" Color="#3B2C08" />
          <SolidColorBrush x:Key="PowerErr" Color="#CF8487" />
          <SolidColorBrush x:Key="PowerErrFg" Color="#FFFFFF" />
          <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#15A066" />
          <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#1DB876" />
          <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#118A57" />
          <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFF" />
          <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FFFFFF" />
          <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#FFFFFF" />
          <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="#C9D1D9" />
          <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#AEB8C2" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <FontFamily x:Key="Mono">Cascadia Mono, Consolas, monospace</FontFamily>

      <!-- Иконки: контуры в сетке 24×24 для Views/Icon.cs (рисуются линией цвета текста). -->
      <StreamGeometry x:Key="IconPower">M12 3 L12 11 M17.66 6.34 A8 8 0 1 1 6.34 6.34</StreamGeometry>
      <StreamGeometry x:Key="IconRefresh">M20 12 A8 8 0 1 1 17.66 6.34 M20 4 L20 9 L15 9</StreamGeometry>
      <StreamGeometry x:Key="IconClose">M6 6 L18 18 M18 6 L6 18</StreamGeometry>
      <StreamGeometry x:Key="IconCheck">M5 12.5 L10 17.5 L19 7</StreamGeometry>
      <StreamGeometry x:Key="IconUp">M6 15 L12 9 L18 15</StreamGeometry>
      <StreamGeometry x:Key="IconDown">M6 9 L12 15 L18 9</StreamGeometry>
      <StreamGeometry x:Key="IconTrash">M4 7 L20 7 M9 7 L9 4 L15 4 L15 7 M6 7 L7 20 L17 20 L18 7 M10 11 L10 16 M14 11 L14 16</StreamGeometry>
      <StreamGeometry x:Key="IconGlobe">M12 3 A9 9 0 1 1 11.99 3 M3 12 L21 12 M12 3 C15 6 15 18 12 21 C9 18 9 6 12 3</StreamGeometry>
      <StreamGeometry x:Key="IconArrowDown">M12 5 L12 19 M6 13 L12 19 L18 13</StreamGeometry>
      <StreamGeometry x:Key="IconArrowUp">M12 19 L12 5 M6 11 L12 5 L18 11</StreamGeometry>
      <StreamGeometry x:Key="IconUndo">M9 14 L4 9 L9 4 M4 9 L15 9 A5 5 0 0 1 15 19 L11 19</StreamGeometry>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <Style Selector="Window">
      <Setter Property="Background" Value="{DynamicResource Bg}" />
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
      <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
    </Style>

    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="26" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource Muted}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.lbl">
      <Setter Property="Foreground" Value="{DynamicResource Label}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="{StaticResource Mono}" />
    </Style>

    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource Card}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="20" />
    </Style>

    <!-- Боковое меню -->
    <Style Selector="Button.nav">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource NavFg}" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Height" Value="44" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="FontSize" Value="15" />
    </Style>
    <Style Selector="Button.nav.on">
      <Setter Property="Background" Value="{DynamicResource NavOnBg}" />
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
    </Style>

    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="Background" Value="{DynamicResource Bg}" />
      <Setter Property="BorderBrush" Value="{DynamicResource FieldBorder}" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="Background" Value="{DynamicResource Bg}" />
      <Setter Property="BorderBrush" Value="{DynamicResource FieldBorder}" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="ToggleButton">
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource Accent}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentDark}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentHover}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentDark}" />
    </Style>

    <!-- Кнопка «i» -->
    <Style Selector="Button.info">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="13" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource InfoBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource NavFg}" />
      <Setter Property="FontStyle" Value="Italic" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Content" Value="i" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.pill">
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Padding" Value="10,3" />
    </Style>
  </Application.Styles>
</Application>
